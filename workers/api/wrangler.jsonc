{
  "name": "sonabrief-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sonabrief-db",
      "database_id": "fd1e6abc-b13f-4d11-84d7-05348cc67632"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "sonabrief-blobs"
    }
  ],
  "vars": {
    "APP_URL": "https://sonabrief.com",
    "LEMONSQUEEZY_STORE_ID": "378856",
    "LEMONSQUEEZY_VARIANT_PRO_MONTHLY": "1668288",
    "LEMONSQUEEZY_VARIANT_PRO_ANNUAL": "1668282",
    "LEMONSQUEEZY_VARIANT_UNLIMITED_MONTHLY": "1668294",
    "LEMONSQUEEZY_VARIANT_UNLIMITED_ANNUAL": "1668295"
  }
}