{
  "name": "sonabrief-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sonabrief-db",
      "database_id": "fd1e6abc-b13f-4d11-84d7-05348cc67632"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "sonabrief-blobs"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    // Polar product IDs
    "POLAR_PRODUCT_PRO_MONTHLY": "081f7ae8-65dd-4bd5-9324-08ebfa26fcb6",
    "POLAR_PRODUCT_PRO_ANNUAL": "1d6f084d-9055-4d8d-a703-8356b87164ce",
    "POLAR_PRODUCT_UNLIMITED_MONTHLY": "8838fecb-6a1f-4d09-8a23-8ee89e6bd0f4",
    "POLAR_PRODUCT_UNLIMITED_ANNUAL": "f21cd53f-6f37-41e9-9bd7-c1385b5ae062",
    // Lemon Squeezy (backup)
    "LEMONSQUEEZY_STORE_ID": "378856",
    "LEMONSQUEEZY_VARIANT_PRO_MONTHLY": "1668288",
    "LEMONSQUEEZY_VARIANT_PRO_ANNUAL": "1668282",
    "LEMONSQUEEZY_VARIANT_UNLIMITED_MONTHLY": "1668294",
    "LEMONSQUEEZY_VARIANT_UNLIMITED_ANNUAL": "1668295"
  }
}
