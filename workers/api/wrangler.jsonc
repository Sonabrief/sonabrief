{
  "name": "sonabrief-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sonabrief-db",
      "database_id": "fd1e6abc-b13f-4d11-84d7-05348cc67632"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "sonabrief-blobs"
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:5173"
  }
}