---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import AboutPage from '../../components/AboutPage.astro';

const lang = 'en';
const t = await getTranslations(lang);
const title: string = t.seo?.about?.title ?? t.about?.sections?.[0]?.title ?? 'About';
const description: string = t.seo?.about?.description ?? t.hero.sub;
---

<BaseLayout lang={lang} title={title} description={description} currentPath="about">
  <main>
    <AboutPage t={t} lang={lang} />
  </main>
</BaseLayout>
