---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import PricingHero from '../../components/pricing/PricingHero.astro';
import PricingTableFull from '../../components/pricing/PricingTableFull.astro';
import PricingEnterprise from '../../components/pricing/PricingEnterprise.astro';
import PricingFAQ from '../../components/pricing/PricingFAQ.astro';

const lang = 'en';
const t = await getTranslations(lang);
const title = t.seo?.pricing?.title ?? t.pricing.title;
const description: string = t.seo?.pricing?.description ?? t.hero.sub;
---

<BaseLayout lang={lang} title={title} description={description} currentPath="pricing">
  <main>
    <PricingHero t={t} lang={lang} />
    <PricingTableFull t={t} lang={lang} />
    <PricingEnterprise t={t} lang={lang} />
    <PricingFAQ t={t} lang={lang} />
  </main>
</BaseLayout>
