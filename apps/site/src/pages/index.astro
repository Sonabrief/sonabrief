---
// Root redirect — rileva lingua browser e reindirizza
---
<html>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const supported = ['en', 'it', 'fr', 'es', 'de'];
      const preferred = (navigator.language || 'en').slice(0, 2).toLowerCase();
      const lang = supported.includes(preferred) ? preferred : 'en';
      window.location.replace('/' + lang + '/');
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
  </head>
  <body></body>
</html>