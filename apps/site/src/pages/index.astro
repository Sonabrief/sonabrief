---
// Root homepage — serves the real EN content server-side (visible in HTML
// source for crawlers). A SEO-safe language redirect runs AFTER the content,
// only for human visitors whose browser prefers a non-EN supported language.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../i18n/utils';
import HeroSection from '../components/landing/HeroSection.astro';
import ProblemSection from '../components/landing/ProblemSection.astro';
import ManifestoSection from '../components/landing/ManifestoSection.astro';
import HowItWorksSection from '../components/landing/HowItWorksSection.astro';
import OutputSampleSection from '../components/landing/OutputSampleSection.astro';
import ThreeWaysSection from '../components/landing/ThreeWaysSection.astro';
import MemorySection from '../components/landing/MemorySection.astro';
import ProfessionalsSection from '../components/landing/ProfessionalsSection.astro';
import OpenSourceSection from '../components/landing/OpenSourceSection.astro';
import PricingSummarySection from '../components/landing/PricingSummarySection.astro';
import FAQSection from '../components/landing/FAQSection.astro';

const lang = 'en';
const t = await getTranslations(lang);
const seo = t.seo?.home ?? { title: t.hero.h1, description: t.hero.sub };
---

<BaseLayout lang={lang} title={seo.title} description={seo.description} currentPath="">
  <main>
    <HeroSection t={t} lang={lang} />
    <ProblemSection t={t} lang={lang} />
    <ManifestoSection t={t} lang={lang} />
    <HowItWorksSection t={t} lang={lang} />
    <OutputSampleSection t={t} lang={lang} />
    <ThreeWaysSection t={t} lang={lang} />
    <MemorySection t={t} lang={lang} />
    <ProfessionalsSection t={t} lang={lang} />
    <OpenSourceSection t={t} lang={lang} />
    <PricingSummarySection t={t} lang={lang} />
    <FAQSection t={t} lang={lang} />
  </main>

  <script is:inline>
    // SEO-safe language redirect. Runs only after the full EN content is in the
    // DOM, so crawlers (which don't navigate on this) index the EN homepage.
    // A human whose browser prefers it/fr/es/de — and who hasn't already chosen
    // a language, and isn't arriving from within the site — gets sent to their
    // localized homepage. Everyone else (incl. EN users and bots) stays here.
    (() => {
      try {
        const supported = ['it', 'fr', 'es', 'de'];
        const pref = (navigator.language || 'en').slice(0, 2).toLowerCase();
        if (!supported.includes(pref)) return; // EN or unsupported → stay
        if (localStorage.getItem('sb-lang-chosen')) return; // user already chose
        const ref = document.referrer;
        if (ref && new URL(ref).hostname === location.hostname) return; // internal nav
        location.replace('/' + pref + '/');
      } catch (_) {
        /* navigator/localStorage unavailable → stay on EN */
      }
    })();
  </script>
</BaseLayout>
