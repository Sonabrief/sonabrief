---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="es"
  title="Sonabrief — Un asistente privado para tus reuniones"
  description="Asistente open-source para reuniones. El audio nunca sale de tu ordenador."
>
  <main class="hero">
    <h1 class="hero-heading">ES — Próximamente</h1>
    <a href="/" class="hero-back">Back to EN</a>
  </main>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 64px);
    padding: 120px 24px 80px;
    gap: 24px;
  }

  .hero-heading {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-deep-teal);
    text-align: center;
    margin: 0;
  }

  .hero-back {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--color-stone);
    text-decoration: underline;
    transition: color 150ms ease;
  }

  .hero-back:hover {
    color: var(--color-deep-teal);
  }
</style>
