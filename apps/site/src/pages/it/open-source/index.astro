---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n/utils';
import OpenSourcePage from '../../../components/OpenSourcePage.astro';

const lang = 'it';
const t = await getTranslations(lang);
const title: string = t.nav?.openSource ?? 'Open source';
---

<BaseLayout lang={lang} title={title} description={t.openSourcePage?.intro ?? ''} currentPath="open-source">
  <main>
    <OpenSourcePage t={t} lang={lang} />
  </main>
</BaseLayout>
