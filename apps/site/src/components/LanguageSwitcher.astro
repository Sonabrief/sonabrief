---
interface Props {
  currentLang: string;
  currentPath?: string;
  /**
   * Restrict the switcher to a subset of languages. Defaults to all 5 site
   * languages (standard pages). pSEO pages pass only the languages the current
   * entry is translated into, so we never link to a non-existent localized URL.
   * EN is always kept (canonical), even if omitted from the list.
   */
  availableLangs?: string[];
}

const { currentLang, currentPath = '', availableLangs } = Astro.props;

// Strip leading lang prefix from path (e.g. "/it/pricing" → "pricing")
const langPrefixes = ['it', 'fr', 'es', 'de'];
let strippedPath = currentPath.replace(/^\//, '');
for (const prefix of langPrefixes) {
  if (strippedPath === prefix || strippedPath.startsWith(prefix + '/')) {
    strippedPath = strippedPath.slice(prefix.length).replace(/^\//, '');
    break;
  }
}

const allLangs = [
  { code: 'en', label: 'EN', href: strippedPath ? `/${strippedPath}` : '/en/' },
  { code: 'it', label: 'IT', href: strippedPath ? `/it/${strippedPath}` : '/it/' },
  { code: 'fr', label: 'FR', href: strippedPath ? `/fr/${strippedPath}` : '/fr/' },
  { code: 'es', label: 'ES', href: strippedPath ? `/es/${strippedPath}` : '/es/' },
  { code: 'de', label: 'DE', href: strippedPath ? `/de/${strippedPath}` : '/de/' },
];

// When a subset is given, keep only those langs (EN always retained as canonical).
const langs = availableLangs
  ? allLangs.filter((l) => l.code === 'en' || availableLangs.includes(l.code))
  : allLangs;
---

<nav class="lang-switcher" aria-label="Language switcher">
  {langs.map(({ code, label, href }, i) => (
    <>
      <a
        href={href}
        class:list={['lang-switcher-link', { active: code === currentLang }]}
        aria-current={code === currentLang ? 'page' : undefined}
        lang={code}
        data-lang-choice
      >
        {label}
      </a>
      {i < langs.length - 1 && (
        <span class="lang-switcher-sep" aria-hidden="true">·</span>
      )}
    </>
  ))}
</nav>

<script is:inline>
  // When the user explicitly picks a language, remember it so the root
  // homepage's auto-redirect (src/pages/index.astro) never overrides them again.
  document.querySelectorAll('[data-lang-choice]').forEach((el) => {
    el.addEventListener('click', () => {
      try {
        localStorage.setItem('sb-lang-chosen', '1');
      } catch (_) {
        /* localStorage unavailable → no-op */
      }
    });
  });
</script>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lang-switcher-link {
    font-family: "Manrope", sans-serif;
    font-size: 13px;
    color: var(--color-stone);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .lang-switcher-link:hover,
  .lang-switcher-link.active {
    color: var(--color-deep-teal);
  }

  .lang-switcher-link.active {
    font-weight: 700;
  }

  .lang-switcher-sep {
    font-size: 13px;
    color: var(--color-mist);
    user-select: none;
  }
</style>
