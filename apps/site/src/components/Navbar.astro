---
import { getTranslations } from '../i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);

const prefix = lang === 'en' ? '' : `/${lang}`;
const homeHref = lang === 'en' ? '/' : `/${lang}/`;
const securityHref = `${prefix}/security`;
const openSourceHref = `${prefix}/open-source`;
const pricingHref = `${prefix}/pricing`;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const normalized = href.replace(/\/$/, '') || '/';
  return currentPath === normalized;
}
---

<header class="navbar">
  <div class="navbar-inner">
    <!-- Logo -->
    <a href={homeHref} class="navbar-logo" aria-label="Sonabrief home">
      <img src="/sonabrief-logo.svg" alt="Sonabrief" height="36" width="37" />
    </a>

    <!-- Nav links (desktop) -->
    <nav class="navbar-links" aria-label="Main navigation">
      <a href={securityHref} class:list={[{ active: isActive(securityHref) }]} aria-current={isActive(securityHref) ? 'page' : undefined}>{t.nav.security}</a>
      <a href={openSourceHref} class:list={[{ active: isActive(openSourceHref) }]} aria-current={isActive(openSourceHref) ? 'page' : undefined}>{t.nav.openSource}</a>
      <a href={pricingHref} class:list={[{ active: isActive(pricingHref) }]} aria-current={isActive(pricingHref) ? 'page' : undefined}>{t.nav.pricing}</a>
      <a href="https://github.com/Sonabrief" target="_blank" rel="noopener noreferrer" plausible-event-name="CTA: GitHub">
        {t.nav.github}&nbsp;↗
      </a>
    </nav>

    <!-- CTA (desktop) -->
    <a href="https://app.sonabrief.com/" class="navbar-cta" plausible-event-name="CTA: Try free">{t.nav.cta}</a>

    <!-- Hamburger (mobile) -->
    <button class="navbar-hamburger" id="navbar-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="navbar-mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile menu overlay -->
  <div class="navbar-mobile-menu" id="navbar-mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <a href={securityHref} class:list={[{ active: isActive(securityHref) }]} aria-current={isActive(securityHref) ? 'page' : undefined}>{t.nav.security}</a>
      <a href={openSourceHref} class:list={[{ active: isActive(openSourceHref) }]} aria-current={isActive(openSourceHref) ? 'page' : undefined}>{t.nav.openSource}</a>
      <a href={pricingHref} class:list={[{ active: isActive(pricingHref) }]} aria-current={isActive(pricingHref) ? 'page' : undefined}>{t.nav.pricing}</a>
      <a href="https://github.com/Sonabrief" target="_blank" rel="noopener noreferrer" plausible-event-name="CTA: GitHub">
        {t.nav.github}&nbsp;↗
      </a>
      <a href="https://app.sonabrief.com/" class="navbar-mobile-cta" plausible-event-name="CTA: Try free">{t.nav.cta}</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-cream);
    border-bottom: 1px solid var(--color-mist);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 64px;
  }

  .navbar-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar-logo img {
    display: block;
    height: 36px;
    width: auto;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 32px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .navbar-links a {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--color-charcoal);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .navbar-links a:hover,
  .navbar-links a.active {
    color: var(--color-deep-teal);
    text-decoration: none;
  }

  .navbar-links a.active {
    font-weight: 600;
  }

  .navbar-cta {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-cream);
    background-color: var(--color-deep-teal);
    padding: 8px 20px;
    border-radius: 9999px;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 150ms ease;
  }

  .navbar-cta:hover {
    opacity: 0.88;
  }

  .navbar-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .navbar-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-charcoal);
    border-radius: 2px;
  }

  .navbar-mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    background-color: var(--color-cream);
    z-index: 49;
    padding: 80px 32px 32px;
  }

  .navbar-mobile-menu.is-open {
    display: flex;
    align-items: flex-start;
  }

  .navbar-mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
  }

  .navbar-mobile-menu a {
    font-family: "Manrope", sans-serif;
    font-size: 20px;
    color: var(--color-charcoal);
    text-decoration: none;
  }

  .navbar-mobile-menu a:hover,
  .navbar-mobile-menu a.active {
    color: var(--color-deep-teal);
  }

  .navbar-mobile-menu a.active {
    font-weight: 600;
  }

  .navbar-mobile-cta {
    display: inline-block;
    margin-top: 8px;
    font-size: 16px !important;
    font-weight: 500;
    color: var(--color-cream) !important;
    background-color: var(--color-deep-teal);
    padding: 12px 28px;
    border-radius: 9999px;
    text-align: center;
  }

  @media (max-width: 767px) {
    .navbar-inner {
      height: 56px;
    }

    .navbar-links,
    .navbar-cta {
      display: none;
    }

    .navbar-hamburger {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('navbar-toggle');
  const menu = document.getElementById('navbar-mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      menu.setAttribute('aria-hidden', String(!isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
  }
</script>
