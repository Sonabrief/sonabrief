---
import PricingCard from '../PricingCard.astro';

interface Props {
  t: any;
  lang: string;
}
const { t, lang } = Astro.props;

interface Tier {
  name: string;
  price: string;
  priceAnnual?: string;
  period?: string;
  highlights: string[];
  cta: string;
}

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const tiers: Tier[] = t.pricing.tiers ?? [];
const claims: string[] = (t.pricing.claims ?? t.pricing.banners ?? []).map(clean);

function ctaHref(name: string): string {
  if (/enterprise/i.test(name)) return 'mailto:hello@sonabrief.com';
  return 'https://app.sonabrief.com/';
}

// gerarchia a 3 livelli, dedotta dal nome (robusta su 5 lingue):
// Pro Unlimited = strong (teal pieno), Pro = soft (amber tenue), resto = none.
function emphasisFor(name: string): 'none' | 'soft' | 'strong' {
  const n = name.toLowerCase();
  if (/unlimited|illimit|ilimit|unbegrenzt/.test(n)) return 'strong';
  if (/\bpro\b/.test(n)) return 'soft';
  return 'none';
}

const pricingPath = lang === 'en' ? '/pricing' : `/${lang}/pricing`;
---

<section class="pricing-summary">
  <div class="pricing-summary-inner">
    <!-- header asimmetrico: titolo serif a sinistra, toggle a destra -->
    <header class="pricing-head">
      <h2 class="pricing-summary-title">{t.pricing.title}</h2>

      <div class="pricing-toggle" role="tablist" aria-label="Billing period">
        <button
          type="button"
          class="pricing-toggle-btn is-active"
          data-period="monthly"
          aria-pressed="true"
        >
          {t.pricing.toggle?.monthly ?? 'Monthly'}
        </button>
        <button
          type="button"
          class="pricing-toggle-btn"
          data-period="annual"
          aria-pressed="false"
        >
          {t.pricing.toggle?.annual ?? 'Annual'}
        </button>
      </div>
    </header>

    <div class="pricing-grid">
      {tiers.map((tier) => (
        <div
          class="pricing-slot"
          data-monthly-price={tier.price}
          data-annual-price={tier.priceAnnual ?? tier.price}
        >
          <PricingCard
            name={tier.name}
            price={tier.price}
            period={tier.period ?? ''}
            description=""
            features={(tier.highlights ?? []).map(clean)}
            cta={tier.cta}
            ctaHref={ctaHref(tier.name)}
            emphasis={emphasisFor(tier.name)}
          />
        </div>
      ))}
    </div>

    {claims.length > 0 && (
      <div class="pricing-claims">
        {claims.map((claim) => (
          <div class="pricing-claim">{claim}</div>
        ))}
      </div>
    )}

    <a href={pricingPath} class="pricing-full-link" plausible-event-name="CTA: Full comparison">{t.pricing.fullComparison}</a>
  </div>
</section>

<style>
  .pricing-summary {
    padding: 120px 24px;
  }

  .pricing-summary-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .pricing-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .pricing-summary-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(30px, 4vw, 48px);
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--color-deep-teal);
    margin: 0;
    text-wrap: balance;
  }

  .pricing-toggle {
    display: inline-flex;
    border: 1px solid var(--color-mist);
    border-radius: 9999px;
    padding: 4px;
    gap: 4px;
    flex-shrink: 0;
  }

  .pricing-toggle-btn {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 20px;
    border: none;
    background: transparent;
    color: var(--color-stone);
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  .pricing-toggle-btn.is-active {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .pricing-claims {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
    margin: 8px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-mist);
    width: 100%;
  }

  /* claims come note: indicatore mono ambra + testo, niente box */
  .pricing-claim {
    font-family: "Manrope", sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-stone);
    padding-left: 18px;
    position: relative;
  }
  .pricing-claim::before {
    content: "·";
    position: absolute;
    left: 2px;
    top: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.3;
    color: var(--color-amber);
  }

  .pricing-full-link {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-decoration-color: var(--color-mist);
    text-underline-offset: 4px;
    margin-top: 8px;
    align-self: flex-start;
    transition: text-decoration-color 200ms var(--ease-out-cubic);
  }
  .pricing-full-link:hover {
    text-decoration-color: var(--color-deep-teal);
  }

  @media (max-width: 1023px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .pricing-summary {
      padding: 80px 24px;
    }
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('.pricing-toggle-btn');
  const slots = document.querySelectorAll<HTMLElement>('.pricing-slot');

  toggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const period = btn.getAttribute('data-period');
      toggles.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });

      slots.forEach((slot) => {
        const monthly = slot.getAttribute('data-monthly-price') ?? '';
        const annual = slot.getAttribute('data-annual-price') ?? monthly;
        const priceEl = slot.querySelector<HTMLElement>('.pricing-card-price');
        if (priceEl) {
          priceEl.textContent = period === 'annual' ? annual : monthly;
        }
      });
    });
  });
</script>
