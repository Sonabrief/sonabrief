---
import PricingCard from '../PricingCard.astro';

interface Props {
  t: any;
  lang: string;
}
const { t, lang } = Astro.props;

interface Tier {
  name: string;
  price: string;
  priceAnnual?: string;
  period?: string;
  highlights: string[];
  cta: string;
}

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const tiers: Tier[] = t.pricing.tiers ?? [];
const claims: string[] = (t.pricing.claims ?? t.pricing.banners ?? []).map(clean);

function ctaHref(name: string): string {
  if (/enterprise/i.test(name)) return 'mailto:hello@sonabrief.com';
  const n = name.toLowerCase();
  if (/unlimited|illimit|ilimit|unbegrenzt/.test(n)) return 'https://app.sonabrief.com/?intent=pro&plan=pro_unlimited';
  if (/\bpro\b/.test(n)) return 'https://app.sonabrief.com/?intent=pro&plan=pro';
  return 'https://app.sonabrief.com/';
}

// Pro è il piano-ancora consigliato: evidenza forte (bordo scuro + CTA piena)
// + badge "Più scelto". Pro Unlimited torna card normale (outline).
// NB: "Pro Unlimited" matcha anche \bpro\b, quindi va escluso PRIMA.
function emphasisFor(name: string): 'none' | 'strong' {
  const n = name.toLowerCase();
  if (/unlimited|illimit|ilimit|unbegrenzt/.test(n)) return 'none';
  if (/\bpro\b/.test(n)) return 'strong';
  return 'none';
}

// badge "Più scelto" solo su Pro (stesso piano dell'evidenza forte).
function isMostPopular(name: string): boolean {
  return emphasisFor(name) === 'strong';
}

const pricingPath = lang === 'en' ? '/pricing' : `/${lang}/pricing`;
---

<section class="pricing-summary">
  <div class="pricing-summary-inner">
    <!-- header asimmetrico: titolo serif a sinistra, toggle a destra -->
    <header class="pricing-head reveal" data-reveal style="--i: 0">
      <h2 class="pricing-summary-title">{t.pricing.title}</h2>

      <div class="pricing-toggle-row">
        <div class="pricing-toggle" role="tablist" aria-label="Billing period">
          <button
            type="button"
            class="pricing-toggle-btn is-active"
            data-period="monthly"
            aria-pressed="true"
          >
            {t.pricing.toggle?.monthly ?? 'Monthly'}
          </button>
          <button
            type="button"
            class="pricing-toggle-btn"
            data-period="annual"
            aria-pressed="false"
          >
            {t.pricing.toggle?.annual ?? 'Annual'}
          </button>
        </div>
        {t.pricing.toggle?.annualNote && (
          <span class="pricing-annual-note" id="pricing-annual-note" hidden>
            {t.pricing.toggle.annualNote}
          </span>
        )}
      </div>
    </header>

    <div class="pricing-grid">
      {tiers.map((tier, i) => (
        <div
          class="pricing-slot reveal"
          data-reveal
          style={`--i: ${i + 1}`}
          data-monthly-price={tier.price}
          data-annual-price={tier.priceAnnual ?? tier.price}
        >
          <PricingCard
            name={tier.name}
            price={tier.price}
            period={tier.period ?? ''}
            description=""
            features={(tier.highlights ?? []).map(clean)}
            cta={tier.cta}
            ctaHref={ctaHref(tier.name)}
            emphasis={emphasisFor(tier.name)}
            badge={isMostPopular(tier.name) ? (t.pricing.mostPopular ?? '') : ''}
          />
        </div>
      ))}
    </div>

    {claims.length > 0 && (
      <div class="pricing-claims">
        {claims.map((claim) => (
          <div class="pricing-claim">{claim}</div>
        ))}
      </div>
    )}

    <a href={pricingPath} class="pricing-full-link" plausible-event-name="CTA: Full comparison">{t.pricing.fullComparison}</a>
  </div>
</section>

<style>
  .pricing-summary {
    padding: var(--section-y) 0;
  }

  .pricing-summary-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .pricing-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .pricing-summary-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(30px, 4vw, 48px);
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--color-deep-teal);
    margin: 0;
    text-wrap: balance;
  }

  /* toggle + nota "2 mesi gratis" affiancati */
  .pricing-toggle-row {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .pricing-toggle {
    display: inline-flex;
    border: 1px solid var(--color-mist);
    border-radius: 9999px;
    padding: 4px;
    gap: 4px;
    flex-shrink: 0;
  }

  /* nota annuale: ambra discreta, stesso register del badge /pricing */
  .pricing-annual-note {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-amber);
    border: 1px solid color-mix(in srgb, var(--color-amber) 50%, transparent);
    padding: 5px 12px;
    border-radius: 9999px;
    white-space: nowrap;
  }
  .pricing-annual-note[hidden] {
    display: none;
  }

  .pricing-toggle-btn {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 20px;
    border: none;
    background: transparent;
    color: var(--color-stone);
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  .pricing-toggle-btn.is-active {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    /* equal-height: tutte le colonne alte come la più alta (default stretch),
       reso esplicito. La card riempie lo slot -> 4 box di pari altezza. */
    align-items: stretch;
  }

  /* lo slot (grid item) si estende all'altezza di riga; la card lo riempie */
  .pricing-slot {
    display: flex;
  }
  .pricing-slot > :global(.pricing-card) {
    width: 100%;
  }

  .pricing-claims {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
    margin: 8px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--color-mist);
    width: 100%;
  }

  /* claims come note: indicatore mono ambra + testo, niente box */
  .pricing-claim {
    font-family: "Manrope", sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-stone);
    padding-left: 18px;
    position: relative;
  }
  .pricing-claim::before {
    content: "·";
    position: absolute;
    left: 2px;
    top: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.3;
    color: var(--color-amber);
  }

  .pricing-full-link {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-decoration-color: var(--color-mist);
    text-underline-offset: 4px;
    margin-top: 8px;
    align-self: flex-start;
    transition: text-decoration-color 200ms var(--ease-out-cubic);
  }
  .pricing-full-link:hover {
    text-decoration-color: var(--color-deep-teal);
  }

  @media (max-width: 1023px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('.pricing-toggle-btn');
  const slots = document.querySelectorAll<HTMLElement>('.pricing-slot');

  const annualNote = document.getElementById('pricing-annual-note');

  toggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const period = btn.getAttribute('data-period');
      toggles.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });

      slots.forEach((slot) => {
        const monthly = slot.getAttribute('data-monthly-price') ?? '';
        const annual = slot.getAttribute('data-annual-price') ?? monthly;
        const priceEl = slot.querySelector<HTMLElement>('.pricing-card-price');
        if (priceEl) {
          priceEl.textContent = period === 'annual' ? annual : monthly;
        }
      });

      // "2 mesi gratis" visibile solo su Annuale
      if (annualNote) annualNote.hidden = period !== 'annual';
    });
  });

  // reveal on-scroll: header + card in stagger
  const revealEls = document.querySelectorAll<HTMLElement>('.pricing-summary [data-reveal]');
  if (revealEls.length) {
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      revealEls.forEach((el) => obs.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-in'));
    }
  }
</script>
