---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface Tier {
  label: string;
  value: string;
  note?: string;
}

const tiers: Tier[] = t.memory.tiers ?? [];

// Neutralizza i dash di rendering (prosa) senza toccare la copy.
function clean(s: string | undefined): string | undefined {
  return s
    ?.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2')
    .replace(/\s*[—–]\s*/g, ', ');
}

const lead = clean(t.memory.lead);
const body = clean(t.memory.body);
const tradeoff = clean(t.memory.tradeoff);

// Il climax della sezione: "Per sempre" è il punto. Riconosco l'ultimo tier
// per evidenziarlo (serif grande, teal) a chiusura della scala ascendente.
const isForever = (v: string) => /forever|sempre|para siempre|toujours|für immer/i.test(v);
---

<section class="mem">
  <div class="mem-inner">
    <header class="mem-head">
      <h2 class="mem-h2">{t.memory.h2}</h2>
      {lead && <p class="mem-lead">{lead}</p>}
    </header>

    <!-- scala ascendente: 7 giorni -> 12 mesi -> per sempre, il valore cresce -->
    <ol class="mem-scale">
      {tiers.map((tier, i) => {
        const climax = isForever(tier.value);
        return (
          <li class:list={['mem-tier', { 'mem-tier--climax': climax }]} data-mem-tier>
            <span class="mem-label">{tier.label}</span>
            <span class="mem-value">
              {tier.value}
              {tier.note && <span class="mem-note">{tier.note}</span>}
            </span>
          </li>
        );
      })}
    </ol>

    <div class="mem-prose">
      {body && <p class="mem-body">{body}</p>}
      {tradeoff && <p class="mem-tradeoff">{tradeoff}</p>}
    </div>
  </div>
</section>

<style>
  .mem {
    padding: 120px 24px;
  }

  .mem-inner {
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* header asimmetrico a sinistra, coerente con ThreeWays */
  .mem-head {
    max-width: 720px;
  }
  .mem-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    text-wrap: balance;
  }
  .mem-lead {
    font-family: "Manrope", sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-stone);
    max-width: 60ch;
    margin: 18px 0 0;
  }

  /* la scala: righe label/valore, il valore serif cresce verso il climax */
  .mem-scale {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .mem-tier {
    display: grid;
    grid-template-columns: 160px 1fr;
    column-gap: 32px;
    align-items: baseline;
    padding: 24px 0;
    border-top: 1px solid var(--color-mist);
  }
  .mem-tier:last-child {
    border-bottom: 1px solid var(--color-mist);
  }

  .mem-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .mem-value {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    /* scala base; cresce sul climax */
    font-size: 24px;
    line-height: 1.1;
    color: var(--color-charcoal);
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .mem-tier--climax .mem-value {
    font-size: clamp(32px, 5vw, 52px);
    color: var(--color-deep-teal);
    letter-spacing: -0.02em;
  }

  .mem-note {
    font-family: "Manrope", sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
    color: var(--color-stone);
    letter-spacing: 0;
  }

  /* prosa di chiusura + tradeoff (il momento di onestà della copy) */
  .mem-prose {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 62ch;
  }
  .mem-body {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-charcoal);
    margin: 0;
  }
  .mem-tradeoff {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone);
    border-left: 2px solid var(--color-amber);
    padding-left: 18px;
    margin: 0;
  }

  /* reveal calmo, stagger per tier — la scala si compone dall'alto */
  .mem-tier {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 600ms var(--ease-out-cubic),
      transform 600ms var(--ease-out-cubic);
  }
  .mem-tier.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mem-tier {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .mem {
      padding: 80px 24px;
    }
    .mem-tier {
      grid-template-columns: 1fr;
      row-gap: 8px;
      padding: 22px 0;
    }
  }
</style>

<script>
  const tiers = document.querySelectorAll<HTMLElement>('[data-mem-tier]');
  if ('IntersectionObserver' in window && tiers.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    tiers.forEach((tier) => observer.observe(tier));
  } else {
    tiers.forEach((tier) => tier.classList.add('is-visible'));
  }
</script>
