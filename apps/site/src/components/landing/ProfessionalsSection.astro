---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

const roles: string[] = t.professionals.roles ?? [];
---

<section class="pros">
  <div class="pros-inner">
    <p class="pros-lead">{t.professionals.lead}</p>

    <div class="pros-roles">
      {roles.map((role) => (
        <p class="pros-role">{role}</p>
      ))}
    </div>

    <p class="pros-close">{t.professionals.close}</p>
    <p class="pros-aside">{t.professionals.aside}</p>
  </div>
</section>

<style>
  .pros {
    padding: 120px 24px;
  }

  .pros-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .pros-lead {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-charcoal);
    margin: 0;
  }

  .pros-roles {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 8px 0;
  }

  .pros-role {
    font-family: "Manrope", sans-serif;
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-charcoal);
    margin: 0;
  }

  .pros-close {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-charcoal);
    margin: 0;
  }

  .pros-aside {
    font-family: "Manrope", sans-serif;
    font-style: italic;
    font-size: 14px;
    color: var(--color-stone);
    margin: 0;
  }

  @media (max-width: 767px) {
    .pros {
      padding: 80px 24px;
    }
    .pros-role {
      font-size: 16px;
    }
  }
</style>
