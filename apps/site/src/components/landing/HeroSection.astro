---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

const h1Raw: string = t.hero.h1;
// "brief" resta in Instrument Serif italic ambra — identità del wordmark, non stile.
const h1Html = h1Raw.replace(/brief/gi, (match) => `<em class="brief-italic">${match}</em>`);

// Manifesto in miniatura: i 3 pilastri come dati mono, anticipano la sezione sotto.
const pillars: { num: string; label: string }[] = t.hero.pillars ?? [];

// L'eyebrow è il primo frammento del claim, non un'etichetta generica.
const eyebrow = 'Una mente privata.';
---

<section class="hero" id="hero">
  <div class="hero-lede fade-up" data-reveal style="--reveal-delay: 0ms;">
    <p class="hero-eyebrow">{eyebrow}</p>
    <h1 class="hero-h1" set:html={h1Html}></h1>
  </div>

  <p class="hero-sub fade-up" data-reveal style="--reveal-delay: 90ms;">{t.hero.sub}</p>

  <!-- riga azione: CTA a sinistra, microcopy a destra, sulla stessa linea -->
  <div class="hero-action-row fade-up" data-reveal style="--reveal-delay: 150ms;">
    <div class="hero-cta-row">
      <a
        href="https://app.sonabrief.com/"
        class="hero-cta-primary"
        plausible-event-name="CTA: Try free"
      >{t.hero.cta1}</a>
      <a href="#how-it-works" class="hero-cta-secondary">{t.hero.cta2}</a>
    </div>

    <p class="hero-micro">{t.hero.micro}</p>
  </div>

  <!-- striscia dati mono full-width, separata da hairline -->
  {pillars.length > 0 && (
    <aside class="hero-pillars fade-up" data-reveal style="--reveal-delay: 220ms;" aria-hidden="true">
      <ul>
        {pillars.map((p) => (
          <li>
            <span class="pillar-num">{p.num}</span>
            <span class="pillar-label">{p.label}</span>
          </li>
        ))}
      </ul>
    </aside>
  )}
</section>

<style>
  /* Composizione: stack verticale. Titolo full-width, sub largo, poi UNA riga
     orizzontale (CTA sinistra + microcopy destra), poi striscia dati mono
     full-width separata da hairline. Niente colonne contrapposte, niente
     vuoto centrale. */
  .hero {
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(88px, 11vw, 128px) var(--gutter) clamp(72px, 9vw, 104px);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 44px);
  }

  .hero-lede {
    margin-bottom: 4px;
  }

  .hero-eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(19px, 2.2vw, 24px);
    line-height: 1;
    color: var(--color-amber);
    margin: 0 0 14px;
    white-space: nowrap;
    /* clearance per i discender dell'italic ('p','q','y' presenti in "privata") */
    padding-bottom: 2px;
  }

  .hero-h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    /* grande: riempie la larghezza dell'hero, l'editoriale è il momento */
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-deep-teal);
    margin: 0;
    max-width: 14ch;
    text-wrap: pretty;
  }

  .hero-sub {
    font-family: "Manrope", sans-serif;
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-stone);
    max-width: 52ch;
    margin: 0;
  }

  /* riga azione: CTA a sinistra, microcopy a destra, sulla stessa linea */
  .hero-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    flex-wrap: wrap;
  }

  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hero-cta-primary {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-cream);
    background-color: var(--color-deep-teal);
    padding: 14px 28px;
    border-radius: 9999px;
    text-decoration: none;
    transition:
      transform 220ms var(--ease-out-cubic),
      opacity 220ms var(--ease-out-cubic);
  }
  /* hover fisico: micro-sollevamento (1px), si sente appena */
  .hero-cta-primary:hover {
    opacity: 0.94;
    transform: translateY(-1px);
  }
  .hero-cta-primary:active {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta-primary:hover,
    .hero-cta-primary:active {
      transform: none;
    }
  }

  .hero-cta-secondary {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-stone);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .hero-cta-secondary:hover {
    color: var(--color-deep-teal);
  }

  .hero-micro {
    font-family: "Manrope", sans-serif;
    font-size: 13px;
    color: var(--color-stone);
    margin: 0;
  }

  /* striscia dati mono full-width, separata da hairline: i 3 pilastri
     distribuiti su 3 colonne, anticipano il manifesto sotto. */
  .hero-pillars {
    padding-top: 24px;
    border-top: 1px solid var(--color-mist);
  }
  .hero-pillars ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 40px;
    max-width: 720px;
  }
  .hero-pillars li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: baseline;
    white-space: nowrap;
  }
  .pillar-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-amber);
    font-variant-numeric: tabular-nums;
  }
  .pillar-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--color-stone);
  }

  /* --- reveal calmo con stagger, gestito via --reveal-delay --- */
  .hero [data-reveal] {
    opacity: 0;
    transform: translateY(var(--reveal-distance));
    transition:
      opacity var(--reveal-duration) var(--ease-out-cubic),
      transform var(--reveal-duration) var(--ease-out-cubic);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .hero.is-revealed [data-reveal] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .hero {
      padding: clamp(72px, 12vw, 96px) var(--gutter) 64px;
      gap: 28px;
    }
    .hero-h1 {
      font-size: clamp(38px, 9vw, 60px);
      max-width: 100%;
    }
    .hero-sub {
      max-width: 100%;
    }
    /* la riga azione impila: CTA sopra, microcopy sotto */
    .hero-action-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  @media (max-width: 540px) {
    /* striscia mono: da 3 colonne a impilata su schermi stretti */
    .hero-pillars ul {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');
  if (hero) {
    const reveal = () => requestAnimationFrame(() => hero.classList.add('is-revealed'));
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              reveal();
              obs.disconnect();
            }
          });
        },
        { threshold: 0.1 }
      );
      obs.observe(hero);
    } else {
      reveal();
    }
  }
</script>
