---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface ManifestoItem {
  num: string;
  title: string;
  body: string;
  linkLabel: string;
}

const items: ManifestoItem[] = t.manifesto.items ?? [];
const linkHrefs = ['https://github.com/Sonabrief', '/security', 'https://github.com/Sonabrief'];
---

<section class="manifesto">
  <div class="manifesto-inner">
    {items.map((item, i) => (
      <div class="manifesto-item fade-up" data-manifesto-item>
        <div class="manifesto-num">{item.num}</div>
        <h3 class="manifesto-title">{item.title}</h3>
        <p class="manifesto-body">{item.body}</p>
        <a href={linkHrefs[i] ?? '#'} class="manifesto-link">{item.linkLabel}</a>
      </div>
    ))}
  </div>
</section>

<style>
  .manifesto {
    padding: 120px 24px;
  }

  .manifesto-inner {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .manifesto-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .manifesto-num {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: var(--color-amber);
    line-height: 1;
    margin-bottom: 8px;
  }

  .manifesto-title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 24px;
    font-weight: 500;
    color: var(--color-deep-teal);
    line-height: 1.3;
    margin: 0;
  }

  .manifesto-body {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  .manifesto-link {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-underline-offset: 4px;
    align-self: flex-start;
    margin-top: 4px;
  }

  @media (max-width: 767px) {
    .manifesto {
      padding: 80px 24px;
    }
    .manifesto-inner {
      gap: 48px;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-manifesto-item]');
  if ('IntersectionObserver' in window && items.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('visible'));
  }
</script>
