---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface ManifestoItem {
  num: string;
  title: string;
  body: string;
  linkLabel: string;
}

const items: ManifestoItem[] = t.manifesto.items ?? [];
const linkHrefs = ['https://github.com/Sonabrief', '/security', 'https://github.com/Sonabrief'];
---

<section class="manifesto">
  <div class="manifesto-inner">
    {items.map((item, i) => (
      <article class="manifesto-item" data-manifesto-item>
        <div class="manifesto-num" aria-hidden="true">{item.num}</div>
        <div class="manifesto-body-col">
          <h3 class="manifesto-title">{item.title}</h3>
          <p class="manifesto-text">{item.body}</p>
          <a href={linkHrefs[i] ?? '#'} class="manifesto-link">{item.linkLabel}</a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .manifesto {
    padding: var(--section-y) 0;
  }

  .manifesto-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
  }

  /* apertura di capitolo editoriale: numero serif grande a margine, testo a destra */
  .manifesto-item {
    display: grid;
    grid-template-columns: 160px minmax(0, 600px);
    column-gap: 56px;
    align-items: start;
    padding: 56px 0;
    border-top: 1px solid var(--color-mist);
  }
  .manifesto-item:first-child {
    border-top: none;
    padding-top: 0;
  }
  .manifesto-item:last-child {
    padding-bottom: 0;
  }

  .manifesto-num {
    font-family: var(--font-serif);
    font-weight: 400;
    font-optical-sizing: auto;
    font-size: clamp(64px, 8vw, 104px);
    line-height: 0.9;
    color: var(--color-amber);
    letter-spacing: -0.02em;
    /* allineamento ottico col titolo a destra */
    margin-top: -0.08em;
  }

  .manifesto-body-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 52ch;
    padding-top: 6px;
  }

  .manifesto-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-deep-teal);
    margin: 0;
    text-wrap: balance;
  }

  .manifesto-text {
    font-family: "Manrope", sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  .manifesto-link {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-decoration-color: var(--color-mist);
    text-underline-offset: 4px;
    align-self: flex-start;
    margin-top: 4px;
    transition: text-decoration-color 200ms var(--ease-out-cubic);
  }
  .manifesto-link:hover {
    text-decoration-color: var(--color-deep-teal);
  }

  /* --- reveal calmo, stagger leggero per item --- */
  .manifesto-item {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 600ms var(--ease-out-cubic),
      transform 600ms var(--ease-out-cubic);
  }
  .manifesto-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 700px) {
    .manifesto {
      padding: 80px 24px;
    }
    .manifesto-item {
      grid-template-columns: 1fr;
      row-gap: 16px;
      column-gap: 0;
      padding: 44px 0;
    }
    .manifesto-num {
      margin-top: 0;
    }
    .manifesto-body-col {
      padding-top: 0;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-manifesto-item]');
  if ('IntersectionObserver' in window && items.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('is-visible'));
  }
</script>
