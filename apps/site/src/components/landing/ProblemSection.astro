---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}
const lines: string[] = (t.problem.lines ?? []).map(clean);
---

<section class="problem">
  <div class="problem-inner">
    {lines.map((line, i) => (
      <p
        class:list={[
          'problem-line',
          { 'problem-line--strong': i === lines.length - 1 },
        ]}
        data-problem-line
        style={`--line-delay: ${i * 120}ms;`}
      >
        {line}
      </p>
    ))}
  </div>
</section>

<style>
  .problem {
    padding: 128px 24px;
  }

  /* affermazione editoriale in crescendo: serif grande, allineato a sinistra
     (rompe il centrato del vecchio layout), SENZA numeri per non anticipare
     il manifesto vero che segue subito dopo. */
  .problem-inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .problem-line {
    font-family: var(--font-serif);
    font-weight: 400;
    font-optical-sizing: auto;
    font-size: clamp(26px, 3.6vw, 40px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-stone);
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
  }

  /* l'affondo finale: "Per te, no." — grande, teal, è il punto */
  .problem-line--strong {
    color: var(--color-deep-teal);
    font-weight: 500;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.05;
    margin-top: 12px;
  }

  /* reveal: le righe entrano in crescendo, una dopo l'altra */
  .problem-line {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 600ms var(--ease-out-cubic),
      transform 600ms var(--ease-out-cubic);
    transition-delay: var(--line-delay, 0ms);
  }
  .problem-inner.is-visible .problem-line {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .problem-line {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .problem {
      padding: 88px 24px;
    }
    .problem-line {
      max-width: 100%;
    }
  }
</style>

<script>
  const inner = document.querySelector<HTMLElement>('.problem-inner');
  if (inner) {
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.disconnect();
            }
          });
        },
        { threshold: 0.4 }
      );
      obs.observe(inner);
    } else {
      inner.classList.add('is-visible');
    }
  }
</script>
