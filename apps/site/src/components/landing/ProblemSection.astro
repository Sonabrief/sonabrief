---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}
const lines: string[] = (t.problem.lines ?? []).map(clean);

// separo il "setup" (le righe sul caso generale) dall'affondo finale ("Per te, no.")
// per drammatizzare il restringimento del fuoco: generale a sinistra, l'affondo
// si stacca spostato a destra, come una replica da un'altra voce.
const setup = lines.slice(0, -1);
const punch = lines[lines.length - 1] ?? '';
---

<section class="problem">
  <div class="problem-inner">
    <div class="problem-setup">
      {setup.map((line, i) => (
        <p class="problem-line" data-problem-line style={`--line-delay: ${i * 120}ms;`}>
          {line}
        </p>
      ))}
    </div>

    <p
      class="problem-line problem-punch"
      data-problem-line
      style={`--line-delay: ${setup.length * 140}ms;`}
    >
      {punch}
    </p>
  </div>
</section>

<style>
  .problem {
    padding: 128px 24px;
  }

  /* crescendo asimmetrico: il setup (caso generale) a sinistra, l'affondo
     "Per te, no." si stacca spostato a destra. Lo scarto orizzontale crea
     la tensione del restringimento del fuoco. SENZA numeri (non anticipa
     il manifesto). */
  .problem-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
  }

  .problem-setup {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 30ch;
  }

  .problem-line {
    font-family: var(--font-serif);
    font-weight: 400;
    font-optical-sizing: auto;
    font-size: clamp(26px, 3.6vw, 40px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-stone);
    margin: 0;
    text-wrap: pretty;
  }

  /* l'affondo: grande, teal, spostato a destra come una replica */
  .problem-punch {
    color: var(--color-deep-teal);
    font-weight: 500;
    font-size: clamp(38px, 5.5vw, 64px);
    line-height: 1.05;
    margin-left: auto;
    margin-right: clamp(0px, 6vw, 96px);
    text-align: right;
  }

  @media (max-width: 700px) {
    .problem-punch {
      margin-right: 0;
      text-align: left;
    }
  }

  /* reveal: le righe entrano in crescendo, una dopo l'altra */
  .problem-line {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 600ms var(--ease-out-cubic),
      transform 600ms var(--ease-out-cubic);
    transition-delay: var(--line-delay, 0ms);
  }
  .problem-inner.is-visible .problem-line {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .problem-line {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .problem {
      padding: 88px 24px;
    }
    .problem-line {
      max-width: 100%;
    }
  }
</style>

<script>
  const inner = document.querySelector<HTMLElement>('.problem-inner');
  if (inner) {
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.disconnect();
            }
          });
        },
        { threshold: 0.4 }
      );
      obs.observe(inner);
    } else {
      inner.classList.add('is-visible');
    }
  }
</script>
