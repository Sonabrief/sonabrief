---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface Step {
  title: string;
  desc: string;
}

const steps: Step[] = t.howItWorks.steps ?? [];
const qualityNote: string | undefined = t.howItWorks.qualityNote;
const cloudNote: string | undefined = t.howItWorks.cloudNote;
---

<section id="how-it-works" class="hiw">
  <div class="hiw-inner">
    <div class="hiw-steps">
      {steps.map((step, i) => (
        <div class="hiw-step">
          <div class="hiw-num">{i + 1}</div>
          <h3 class="hiw-title">{step.title}</h3>
          <p class="hiw-desc">{step.desc}</p>
        </div>
      ))}
    </div>

    {qualityNote && (
      <p class="hiw-quality">{qualityNote}</p>
    )}

    {cloudNote && (
      <div class="hiw-cloud">
        <span class="hiw-cloud-badge">Pro &amp; Pro Unlimited</span>
        <p class="hiw-cloud-text">{cloudNote}</p>
      </div>
    )}
  </div>
</section>

<style>
  .hiw {
    padding: 120px 24px;
  }

  .hiw-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .hiw-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .hiw-step {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .hiw-num {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hiw-title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--color-deep-teal);
    margin: 0;
  }

  .hiw-desc {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  .hiw-quality {
    font-family: "Manrope", sans-serif;
    font-style: italic;
    font-size: 15px;
    color: var(--color-stone);
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .hiw-cloud {
    border: 1px solid var(--color-amber);
    border-radius: 12px;
    padding: 24px 28px;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hiw-cloud-badge {
    font-family: "Manrope", sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-amber);
  }

  .hiw-cloud-text {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-charcoal);
    margin: 0;
  }

  @media (max-width: 767px) {
    .hiw {
      padding: 80px 24px;
    }
    .hiw-steps {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
