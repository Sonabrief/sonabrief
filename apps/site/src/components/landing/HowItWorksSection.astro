---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface Step {
  title: string;
  desc: string;
}

const steps: Step[] = t.howItWorks.steps ?? [];
const rawQuality: string | undefined = t.howItWorks.qualityNote;
const rawCloud: string | undefined = t.howItWorks.cloudNote;

// Neutralizza i dash di rendering senza toccare la copy JSON:
// range numerico (1-2) -> trattino; dash retorico -> virgola in prosa.
function clean(s: string | undefined): string | undefined {
  return s
    ?.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2')
    .replace(/\s*[—–]\s*/g, ', ');
}

const cleanSteps = steps.map((s) => ({ title: s.title, desc: clean(s.desc) }));
const qualityNote = clean(rawQuality);
const cloudNote = clean(rawCloud);
const badge = 'Pro & Pro Unlimited';
---

<section id="how-it-works" class="hiw">
  <div class="hiw-inner">
    <!-- flusso ORIZZONTALE: la sequenza temporale si legge da sinistra a destra.
         Niente numeri (quelli stanno al manifesto): il flusso stesso è il device. -->
    <ol class="hiw-flow" data-hiw-flow>
      {cleanSteps.map((step, i) => (
        <li class="hiw-step" data-hiw-step>
          <div class="hiw-marker" aria-hidden="true">
            <span class="hiw-dot"></span>
            {i < cleanSteps.length - 1 && <span class="hiw-arrow">→</span>}
          </div>
          <h3 class="hiw-title">{step.title}</h3>
          <p class="hiw-desc">{step.desc}</p>
        </li>
      ))}
    </ol>

    <div class="hiw-notes">
      {qualityNote && <p class="hiw-quality">{qualityNote}</p>}

      {cloudNote && (
        <p class="hiw-cloud">
          <span class="hiw-cloud-badge">{badge}</span>
          <span class="hiw-cloud-text">{cloudNote}</span>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .hiw {
    padding: 120px 24px;
  }

  .hiw-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  /* --- flusso orizzontale a 3 tappe --- */
  .hiw-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .hiw-step {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* marker: pallino discreto sulla linea + freccia verso la tappa successiva */
  .hiw-marker {
    position: relative;
    height: 9px;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
  }
  .hiw-dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background-color: var(--color-deep-teal);
    flex-shrink: 0;
    z-index: 1;
  }
  /* linea orizzontale che attraversa la tappa, sotto il pallino */
  .hiw-marker::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    transform: translateY(-50%);
    background-color: var(--color-mist);
  }
  /* la freccia siede a destra, sul connettore tra una tappa e l'altra */
  .hiw-arrow {
    position: absolute;
    right: -24px;
    top: 50%;
    transform: translateY(-50%);
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1;
    color: var(--color-amber);
    background-color: var(--color-cream);
    padding: 0 4px;
    z-index: 2;
  }

  .hiw-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: 22px;
    line-height: 1.2;
    color: var(--color-deep-teal);
    margin: 0;
  }
  .hiw-desc {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  /* --- note: nota editoriale + riga cloud col badge (no box) --- */
  .hiw-notes {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 720px;
  }
  .hiw-quality {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
    max-width: 62ch;
  }
  .hiw-cloud {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 16px;
    align-items: baseline;
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--color-mist);
    max-width: 62ch;
  }
  .hiw-cloud-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-amber);
    white-space: nowrap;
  }
  .hiw-cloud-text {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-charcoal);
  }

  /* reveal calmo: le tappe entrano in sequenza, L->R */
  .hiw-step {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 600ms var(--ease-out-cubic),
      transform 600ms var(--ease-out-cubic);
  }
  .hiw-step:nth-child(2) { transition-delay: 90ms; }
  .hiw-step:nth-child(3) { transition-delay: 180ms; }
  .hiw-flow.is-visible .hiw-step {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-step {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* tablet: 3 -> verticale, la freccia ruota a "giù" */
  @media (max-width: 767px) {
    .hiw {
      padding: 80px 24px;
    }
    .hiw-flow {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hiw-marker {
      margin-bottom: 4px;
    }
    /* in verticale la linea orizzontale non ha senso: la nascondo,
       tengo solo il pallino come ancora discreta */
    .hiw-marker::before {
      display: none;
    }
    .hiw-arrow {
      right: auto;
      left: 0;
      top: auto;
      bottom: -28px;
      transform: rotate(90deg);
      background-color: transparent;
    }
  }
</style>

<script>
  const flow = document.querySelector<HTMLElement>('[data-hiw-flow]');
  if (flow) {
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.disconnect();
            }
          });
        },
        { threshold: 0.3 }
      );
      obs.observe(flow);
    } else {
      flow.classList.add('is-visible');
    }
  }
</script>
