---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const h2 = clean(t.openSource.h2);
const body = clean(t.openSource.body);
const contribute = clean(t.openSource.contribute);

// builtWith è "Costruito con Whisper · Ollama · Mistral · ... — standard aperti, codice aperto."
// Estraggo lo stack (i nomi separati da ·) per renderlo come riga mono di chip,
// elemento distintivo che nessun'altra sezione ha. La coda resta come nota.
const rawBuilt: string = t.openSource.builtWith ?? '';
const builtParts = rawBuilt.split(/—|–/);
const stackRaw = builtParts[0] ?? rawBuilt;
const builtTail = builtParts[1] ? builtParts[1].trim() : '';
const stackItems = stackRaw
  .split('·')
  .map((s) => s.trim())
  .filter(Boolean)
  // il primo segmento porta il prefisso ("Costruito con Whisper" / "Built with Whisper"
  // / "Construido con Whisper" / "Mit Whisper" / "Conçu avec Whisper"): tengo solo
  // il nome della tecnologia rimuovendo le parole-prefisso iniziali (minuscole + con/with/avec/mit).
  .map((s, i) =>
    i === 0
      ? s.replace(/^.*?\b(?:con|with|avec|mit)\s+/i, '').trim() || s
      : s
  );
const hasStack = stackItems.length >= 2;
---

<section class="oss" data-oss>
  <div class="oss-inner">
    <h2 class="oss-h2 reveal" data-reveal style="--i: 0">{h2}</h2>
    <p class="oss-body reveal" data-reveal style="--i: 1">{body}</p>

    <div class="oss-cta-row reveal" data-reveal style="--i: 2">
      <a href="https://github.com/Sonabrief" class="oss-cta oss-cta--primary" target="_blank" rel="noopener noreferrer" plausible-event-name="CTA: GitHub">
        {clean(t.openSource.cta1)}
      </a>
      <a href="/security" class="oss-cta">{clean(t.openSource.cta2)}</a>
    </div>

    {hasStack ? (
      <div class="oss-stack reveal" data-reveal style="--i: 3" aria-label="Open-source stack">
        <ul class="oss-stack-list">
          {stackItems.map((item) => (
            <li class="oss-chip">{item}</li>
          ))}
        </ul>
        {builtTail && <p class="oss-stack-tail">{builtTail}</p>}
      </div>
    ) : (
      <p class="oss-meta reveal" data-reveal style="--i: 3">{clean(rawBuilt)}</p>
    )}

    <p class="oss-meta reveal" data-reveal style="--i: 4">{contribute}</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-oss]');
  const els = root?.querySelectorAll<HTMLElement>('[data-reveal]');
  if (els && els.length) {
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.2 }
      );
      els.forEach((el) => obs.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-in'));
    }
  }
</script>

<style>
  .oss {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
    padding: var(--section-y) 0;
  }

  .oss-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .oss-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(30px, 4vw, 48px);
    letter-spacing: -0.015em;
    color: var(--color-cream);
    margin: 0;
    line-height: 1.12;
    max-width: 18ch;
    text-wrap: balance;
  }

  .oss-body {
    font-family: "Manrope", sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-cream);
    opacity: 0.82;
    margin: 0;
    max-width: 60ch;
  }

  .oss-cta-row {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .oss-cta {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-cream);
    background: transparent;
    border: 1.5px solid color-mix(in srgb, var(--color-cream) 35%, transparent);
    padding: 12px 24px;
    border-radius: 9999px;
    text-decoration: none;
    transition:
      background-color 200ms var(--ease-out-cubic),
      color 200ms var(--ease-out-cubic),
      border-color 200ms var(--ease-out-cubic),
      transform 200ms var(--ease-out-cubic);
  }
  /* CTA primaria: piena ambra, l'accento caldo che risalta sul teal */
  .oss-cta--primary {
    background-color: var(--color-amber);
    border-color: var(--color-amber);
    color: var(--color-deep-teal);
  }
  .oss-cta--primary:hover {
    opacity: 0.94;
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .oss-cta:hover,
    .oss-cta:active {
      transform: none;
    }
  }
  .oss-cta:not(.oss-cta--primary):hover {
    background-color: var(--color-cream);
    border-color: var(--color-cream);
    color: var(--color-deep-teal);
  }
  .oss-cta:active {
    transform: translateY(1px);
  }

  /* stack tecnologico in mono: il device distintivo di questa sezione */
  .oss-stack {
    margin-top: 20px;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .oss-stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
  }
  .oss-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--color-cream);
    border: 1px solid color-mix(in srgb, var(--color-cream) 22%, transparent);
    border-radius: 6px;
    padding: 5px 10px;
  }
  .oss-stack-tail {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-amber);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .oss-meta {
    font-family: "Manrope", sans-serif;
    font-size: 13px;
    color: var(--color-cream);
    opacity: 0.6;
    margin: 0;
    line-height: 1.6;
    max-width: 62ch;
  }

  @media (max-width: 767px) {
    .oss-h2 {
      max-width: 100%;
    }
  }
</style>
