---
import AccordionFAQ from '../AccordionFAQ.astro';

interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface FAQEntry {
  q: string;
  a: string;
}

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const rawItems: FAQEntry[] = t.faq.items ?? [];
const items = rawItems.map((it) => ({ question: clean(it.q), answer: clean(it.a) }));
---

<section class="faq">
  <div class="faq-inner">
    <!-- header a 2 colonne: titolo serif fisso a sinistra, accordion a destra.
         Layout-family distinta da Pricing (card grid) che precede; il titolo
         "ancora" la lista mentre si apre/chiude. -->
    <div class="faq-aside reveal" data-faq-reveal>
      <h2 class="faq-title">{t.faq.title}</h2>
    </div>
    <div class="faq-list">
      <AccordionFAQ items={items} />
    </div>
  </div>
</section>

<style>
  .faq {
    padding: var(--section-y) 0;
  }

  .faq-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    column-gap: 64px;
    align-items: start;
  }

  .faq-aside {
    position: sticky;
    top: 96px;
  }

  .faq-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    max-width: 16ch;
    text-wrap: balance;
  }

  @media (max-width: 860px) {
    .faq-inner {
      grid-template-columns: 1fr;
      row-gap: 32px;
    }
    .faq-aside {
      position: static;
    }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-faq-reveal]');
  if (el) {
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              obs.disconnect();
            }
          });
        },
        { threshold: 0.3 }
      );
      obs.observe(el);
    } else {
      el.classList.add('is-in');
    }
  }
</script>
