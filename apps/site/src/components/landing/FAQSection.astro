---
import AccordionFAQ from '../AccordionFAQ.astro';

interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface FAQEntry {
  q: string;
  a: string;
}

const rawItems: FAQEntry[] = t.faq.items ?? [];
const items = rawItems.map((it) => ({ question: it.q, answer: it.a }));
---

<section class="faq">
  <div class="faq-inner">
    <h2 class="faq-title">{t.faq.title}</h2>
    <AccordionFAQ items={items} />
  </div>
</section>

<style>
  .faq {
    padding: 120px 24px;
  }

  .faq-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .faq-title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-deep-teal);
    margin: 0;
  }

  @media (max-width: 767px) {
    .faq {
      padding: 80px 24px;
    }
  }
</style>
