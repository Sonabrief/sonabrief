---
// Shared renderer for /compare/[slug] across all 5 languages.
// The 5 route wrappers stay thin: they resolve `lang` and hand the entry here.
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveCopy, buildAvailableHreflangs, getAvailableLangs } from '../../content/pseo-utils';
import type { LangCode } from '../../content/pseo-utils';

interface Props {
  // The collection entry's `data` object (already validated by the schema).
  entry: any;
  lang: LangCode;
}

const { entry, lang } = Astro.props;

const { slug, competitor, category, verified, differentiators, i18n } = entry;

// Resolve copy for this language; fall back to EN if untranslated.
const { copy, isFallback } = resolveCopy(i18n, lang);

// Section path WITHOUT language prefix. BaseLayout prepends the lang itself
// for canonical/OG (en → root, others → /{lang}/…), matching the convention
// used by the hand-written localized pages (they pass e.g. "pricing").
const pathWithoutLang = `compare/${slug}`;
const currentPath = pathWithoutLang;

// hreflang + footer switcher: only languages this entry is translated into.
const hreflangAlternates = buildAvailableHreflangs(i18n, pathWithoutLang);
const availableLangs = getAvailableLangs(i18n);

// If we're showing EN fallback on a non-EN URL, the page must not be indexed.
const noindex = isFallback;

const introHtml = marked(copy.intro) as string;
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  currentPath={currentPath}
  hreflangAlternates={hreflangAlternates}
  availableLangs={availableLangs}
  noindex={noindex}
>
  <main class="pseo-wrapper">
    <article class="pseo-article">
      {!verified && (
        <div class="pseo-draft-banner" role="note">
          ⚠️ Placeholder / unverified comparison — not for production.
        </div>
      )}

      <p class="pseo-eyebrow">{category}</p>
      <h1 class="pseo-h1">{copy.title}</h1>

      <div class="pseo-intro" set:html={introHtml} />

      {differentiators && differentiators.length > 0 && (
        <section class="pseo-table-section" aria-label="Comparison">
          <table class="pseo-table">
            <thead>
              <tr>
                <th></th>
                <th>Sonabrief</th>
                <th>{competitor}</th>
              </tr>
            </thead>
            <tbody>
              {differentiators.map((row: any) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>{row.sonabrief ?? '—'}</td>
                  <td>{row.competitor ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}

      {copy.faq && copy.faq.length > 0 && (
        <section class="pseo-faq" aria-label="FAQ">
          <h2 class="pseo-h2">FAQ</h2>
          {copy.faq.map((item: { q: string; a: string }) => (
            <details class="pseo-faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>
      )}
    </article>
  </main>
</BaseLayout>

<style>
  .pseo-wrapper {
    background-color: var(--color-cream);
    min-height: 100vh;
    padding: 80px var(--gutter) 120px;
  }
  @media (max-width: 767px) {
    .pseo-wrapper { padding: 48px 20px 80px; }
  }
  .pseo-article {
    max-width: var(--container-prose, 760px);
    margin: 0 auto;
  }
  .pseo-draft-banner {
    border: 1px solid var(--color-amber, #c98a2b);
    background: color-mix(in srgb, var(--color-amber, #c98a2b) 14%, transparent);
    padding: 12px 16px;
    border-radius: 8px;
    font-family: "Manrope", sans-serif;
    font-size: 13px;
    color: var(--color-charcoal);
    margin-bottom: 32px;
  }
  .pseo-eyebrow {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-stone);
    margin-bottom: 8px;
  }
  .pseo-h1 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--color-deep-teal);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 24px;
  }
  .pseo-h2 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--color-charcoal);
    margin: 48px 0 20px;
  }
  .pseo-intro :global(p) {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-charcoal);
    margin-bottom: 20px;
    max-width: 65ch;
  }
  .pseo-table {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    border-collapse: collapse;
    width: 100%;
    margin: 32px 0;
    display: block;
    overflow-x: auto;
  }
  .pseo-table th,
  .pseo-table td {
    padding: 10px 12px;
    border: 1px solid var(--color-mist);
    text-align: left;
    vertical-align: top;
    color: var(--color-charcoal);
  }
  .pseo-table thead th {
    background: color-mix(in srgb, var(--color-mist) 40%, transparent);
    font-weight: 600;
  }
  .pseo-faq-item {
    border-bottom: 1px solid var(--color-mist);
    padding: 12px 0;
  }
  .pseo-faq-item summary {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-weight: 600;
    cursor: pointer;
    color: var(--color-charcoal);
  }
  .pseo-faq-item p {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-charcoal);
    margin-top: 8px;
  }
</style>
