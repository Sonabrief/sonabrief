---
// Shared renderer for /for/[slug] across all 5 languages.
// Same design language as ComparePage / the rest of the site.
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccordionFAQ from '../AccordionFAQ.astro';
import { getTranslations } from '../../i18n/utils';
import { resolveCopy, buildAvailableHreflangs, getAvailableLangs } from '../../content/pseo-utils';
import type { LangCode } from '../../content/pseo-utils';

interface Props {
  entry: any;
  lang: LangCode;
}

const { entry, lang } = Astro.props;
const { slug, draft, secondaryCta, i18n } = entry;

const t = await getTranslations(lang);
const pseo = t.pseo ?? {};
const cta = pseo.cta ?? {};

const { copy, isFallback } = resolveCopy(i18n, lang);

// profession + painPoints now live per-language inside copy, with top-level fallback.
const profession = copy.profession ?? entry.profession;
const painPoints = copy.painPoints ?? entry.painPoints;

const pathWithoutLang = `for/${slug}`;
const currentPath = pathWithoutLang;
const hreflangAlternates = buildAvailableHreflangs(i18n, pathWithoutLang);
const availableLangs = getAvailableLangs(i18n);
// noindex when the entry is an explicit draft OR we're serving an EN fallback.
const noindex = draft === true || isFallback;

const introHtml = marked(copy.intro) as string;

const faqItems = (copy.faq ?? []).map((f: { q: string; a: string }) => ({
  question: f.q,
  answer: f.a,
}));

// Secondary CTA: entry override (href without lang prefix) or default /security.
const cta2Href = secondaryCta?.href ?? 'security';
const secondaryHref = lang === 'en' ? `/${cta2Href}` : `/${lang}/${cta2Href}`;
const secondaryLabel =
  (secondaryCta?.labelKey && cta[secondaryCta.labelKey]) || cta.secondary || 'How we keep it private';
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  currentPath={currentPath}
  hreflangAlternates={hreflangAlternates}
  availableLangs={availableLangs}
  noindex={noindex}
>
  <main class="frp">
    {draft && (
      <div class="frp-draft" role="note">
        ⚠️ Draft copy for "{profession}" — not for production.
      </div>
    )}

    <header class="frp-head">
      <p class="frp-eyebrow reveal" data-reveal style="--i: 0">{profession}</p>
      <h1 class="frp-h1 reveal" data-reveal style="--i: 1">{copy.title}</h1>
    </header>

    {painPoints && painPoints.length > 0 && (
      <ul class="frp-painpoints reveal" data-reveal style="--i: 2" aria-label="Pain points">
        {painPoints.map((p: string) => (
          <li>
            <span class="frp-pp-dot" aria-hidden="true"></span>
            {p}
          </li>
        ))}
      </ul>
    )}

    <div class="frp-intro reveal" data-reveal style="--i: 3" set:html={introHtml} />

    {faqItems.length > 0 && (
      <section class="frp-faq" aria-label="FAQ">
        <h2 class="frp-h2 reveal" data-reveal style="--i: 0">{pseo.faqHeading ?? 'FAQ'}</h2>
        <AccordionFAQ items={faqItems} />
      </section>
    )}

    <section class="frp-cta reveal" data-reveal aria-label="Get started">
      <p class="frp-cta-title">{cta.title ?? 'Try Sonabrief free'}</p>
      <p class="frp-cta-body">{cta.body ?? ''}</p>
      <div class="frp-cta-actions">
        <a class="frp-cta-primary" href="https://app.sonabrief.com/" plausible-event-name="CTA: Try free">
          {cta.primary ?? 'Get started free'}
        </a>
        <a class="frp-cta-secondary" href={secondaryHref}>
          {secondaryLabel} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .frp {
    max-width: var(--container-prose);
    margin-inline: auto;
    padding: clamp(72px, 9vw, 112px) var(--gutter) clamp(80px, 10vw, 128px);
  }

  .frp-draft {
    border: 1px solid var(--color-amber);
    background: color-mix(in srgb, var(--color-amber) 12%, transparent);
    padding: 12px 16px;
    border-radius: 10px;
    font-family: "Manrope", sans-serif;
    font-size: 13px;
    color: var(--color-charcoal);
    margin-bottom: 40px;
  }

  .frp-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-amber);
    margin: 0 0 16px;
  }
  .frp-h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-deep-teal);
    margin: 0 0 32px;
    max-width: 18ch;
  }

  .frp-painpoints {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .frp-painpoints li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-stone);
  }
  .frp-pp-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-amber);
    flex-shrink: 0;
    transform: translateY(-2px);
  }

  .frp-intro :global(h2) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(22px, 3vw, 28px);
    color: var(--color-deep-teal);
    line-height: 1.25;
    margin: 0 0 24px;
  }
  .frp-intro :global(p) {
    font-family: "Manrope", sans-serif;
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-charcoal);
    margin: 0 0 22px;
    max-width: 65ch;
  }
  .frp-intro :global(strong) {
    color: var(--color-deep-teal);
    font-weight: 600;
  }

  .frp-faq {
    margin: clamp(56px, 8vw, 88px) 0 0;
  }
  .frp-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(24px, 3.5vw, 32px);
    color: var(--color-deep-teal);
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .frp-cta {
    margin-top: clamp(56px, 8vw, 88px);
    border: 1px solid var(--color-mist);
    border-radius: 20px;
    background: color-mix(in srgb, var(--color-deep-teal) 4%, transparent);
    padding: clamp(32px, 5vw, 48px);
    text-align: center;
  }
  .frp-cta-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(22px, 3vw, 28px);
    color: var(--color-deep-teal);
    margin: 0 0 10px;
  }
  .frp-cta-body {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-stone);
    margin: 0 auto 24px;
    max-width: 46ch;
  }
  .frp-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px 24px;
    flex-wrap: wrap;
  }
  .frp-cta-primary {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-cream);
    background: var(--color-deep-teal);
    border: 1.5px solid var(--color-deep-teal);
    padding: 13px 28px;
    border-radius: 9999px;
    text-decoration: none;
    transition: opacity 150ms ease, transform 150ms ease;
  }
  .frp-cta-primary:hover {
    opacity: 0.92;
  }
  .frp-cta-primary:active {
    transform: translateY(1px);
  }
  .frp-cta-secondary {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-deep-teal);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .frp-cta-secondary:hover {
    color: color-mix(in srgb, var(--color-deep-teal) 75%, var(--color-amber));
  }
</style>
