---
interface Props {
  t: any;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const title: string = clean(t.security.mistral.title);
const body: string = clean(t.security.mistral.body);
const cta: string = clean(t.security.mistral.cta);

const mailto = 'mailto:hello@sonabrief.com?subject=DPA reference request';
---

<section class="mistral">
  <div class="mistral-inner">
    <h2 class="mistral-h2 reveal" data-reveal style="--i: 0">{title}</h2>
    <p class="mistral-body reveal" data-reveal style="--i: 1">{body}</p>
    <a class="mistral-cta reveal" data-reveal style="--i: 2" href={mailto}>{cta}</a>
  </div>
</section>

<style>
  /* blocco editoriale di respiro: H2 serif grande, body largo, una CTA */
  .mistral {
    padding: clamp(64px, 8vw, 96px) 0;
  }

  .mistral-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mistral-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(28px, 3.6vw, 44px);
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.12;
    max-width: 22ch;
    text-wrap: balance;
  }

  .mistral-body {
    font-family: "Manrope", sans-serif;
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-stone);
    margin: 0;
    max-width: 62ch;
  }

  .mistral-cta {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-decoration-color: var(--color-mist);
    text-underline-offset: 4px;
    width: fit-content;
    margin-top: 8px;
    transition: text-decoration-color 200ms var(--ease-out-cubic);
  }
  .mistral-cta:hover {
    text-decoration-color: var(--color-deep-teal);
  }
</style>
