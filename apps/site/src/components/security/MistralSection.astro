---
interface Props {
  t: any;
}
const { t } = Astro.props;

const title: string = t.security.mistral.title;
const body: string = t.security.mistral.body;
const cta: string = t.security.mistral.cta;

const mailto = 'mailto:hello@sonabrief.com?subject=DPA reference request';
---

<section class="mistral">
  <div class="mistral-inner">
    <h2 class="mistral-h2">{title}</h2>
    <p class="mistral-body">{body}</p>
    <a class="mistral-cta" href={mailto}>{cta}</a>
  </div>
</section>

<style>
  .mistral {
    padding: 80px 24px;
  }

  .mistral-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mistral-h2 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.2;
  }

  .mistral-body {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-stone);
    margin: 0;
    max-width: 680px;
  }

  .mistral-cta {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-underline-offset: 4px;
    width: fit-content;
  }

  @media (max-width: 767px) {
    .mistral {
      padding: 56px 24px;
    }
  }
</style>
