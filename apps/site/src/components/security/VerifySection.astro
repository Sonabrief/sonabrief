---
interface Props {
  t: any;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const title: string = clean(t.security.verify.title);
const intro: string = clean(t.security.verify.intro);
const steps: string[] = (t.security.verify.steps ?? []).map(clean);
const codeLinks: string[] = (t.security.verify.codeLinks ?? []).map(clean);

// Real paths in the open source repo:
//  - the function that discards audio after transcription
//  - the libsodium encryption function
const codeHrefs = [
  'https://github.com/Sonabrief/sonabrief/blob/main/apps/web/src/lib/chunkStore.ts#L86-L90',
  'https://github.com/Sonabrief/sonabrief/blob/main/apps/web/src/lib/crypto.ts#L29-L48',
];
---

<section class="verify">
  <div class="verify-inner">
    <div class="verify-box">
      <h2 class="verify-title">{title}</h2>
    <p class="verify-intro">{intro}</p>

    <ol class="verify-steps">
      {
        steps.map((step, i) => (
          <li class="verify-step">
            <span class="verify-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="verify-step-text">{step}</span>
          </li>
        ))
      }
    </ol>

    <div class="verify-links">
      {
        codeLinks.map((label, i) => (
          <a class="verify-link" href={codeHrefs[i] ?? 'https://github.com/Sonabrief/sonabrief'} target="_blank" rel="noopener noreferrer">
            {label}
          </a>
        ))
      }
    </div>
    </div>
  </div>
</section>

<style>
  .verify {
    padding: clamp(64px, 8vw, 96px) 0;
  }

  /* stesso container delle altre sezioni: niente larghezza propria */
  .verify-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* il blocco "fallo da solo": riquadro distinto, numeri serif ambra a margine */
  .verify-box {
    border: 1.5px solid var(--color-deep-teal);
    background-color: color-mix(in srgb, var(--color-deep-teal) 4%, var(--color-cream));
    border-radius: 16px;
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .verify-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(24px, 3vw, 36px);
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.14;
  }

  .verify-intro {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-stone);
    margin: 0;
  }

  .verify-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .verify-step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 20px;
    align-items: start;
    padding: 18px 0;
    border-top: 1px solid color-mix(in srgb, var(--color-deep-teal) 14%, transparent);
  }
  .verify-step:first-child {
    border-top: none;
    padding-top: 0;
  }
  .verify-step:last-child {
    padding-bottom: 0;
  }

  .verify-num {
    font-family: var(--font-serif);
    font-weight: 400;
    font-optical-sizing: auto;
    font-size: 28px;
    line-height: 1;
    color: var(--color-amber);
    font-variant-numeric: tabular-nums;
  }

  .verify-step-text {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-charcoal);
    padding-top: 4px;
  }

  .verify-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }

  .verify-link {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-underline-offset: 4px;
    width: fit-content;
  }

  @media (max-width: 767px) {
    .verify {
      padding: 56px var(--gutter);
    }
    .verify-box {
      padding: 28px;
    }
  }
</style>
