---
interface Props {
  t: any;
}
const { t } = Astro.props;

const title: string = t.security.verify.title;
const intro: string = t.security.verify.intro;
const steps: string[] = t.security.verify.steps ?? [];
const codeLinks: string[] = t.security.verify.codeLinks ?? [];

// Real paths in the open source repo:
//  - the function that discards audio after transcription
//  - the libsodium encryption function
const codeHrefs = [
  'https://github.com/Sonabrief/sonabrief/blob/main/apps/web/src/lib/chunkStore.ts#L86-L90',
  'https://github.com/Sonabrief/sonabrief/blob/main/apps/web/src/lib/crypto.ts#L29-L48',
];
---

<section class="verify">
  <div class="verify-box">
    <h2 class="verify-title">{title}</h2>
    <p class="verify-intro">{intro}</p>

    <ol class="verify-steps">
      {
        steps.map((step, i) => (
          <li class="verify-step">
            <span class="verify-num" aria-hidden="true">{i + 1}</span>
            <span class="verify-step-text">{step}</span>
          </li>
        ))
      }
    </ol>

    <div class="verify-links">
      {
        codeLinks.map((label, i) => (
          <a class="verify-link" href={codeHrefs[i] ?? 'https://github.com/Sonabrief/sonabrief'} target="_blank" rel="noopener noreferrer">
            {label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .verify {
    padding: 80px var(--gutter);
    display: flex;
    justify-content: center;
  }

  .verify-box {
    max-width: var(--container-prose);
    width: 100%;
    border: 2px solid var(--color-deep-teal);
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .verify-title {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.2;
  }

  .verify-intro {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-stone);
    margin: 0;
  }

  .verify-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    counter-reset: none;
  }

  .verify-step {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
  }

  .verify-num {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .verify-step-text {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-charcoal);
  }

  .verify-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }

  .verify-link {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-underline-offset: 4px;
    width: fit-content;
  }

  @media (max-width: 767px) {
    .verify {
      padding: 56px var(--gutter);
    }
    .verify-box {
      padding: 28px;
    }
  }
</style>
