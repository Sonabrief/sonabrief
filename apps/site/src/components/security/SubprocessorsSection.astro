---
interface Props {
  t: any;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const title: string = clean(t.security.subprocessors.title);
const intro: string = clean(t.security.subprocessors.intro);
const headers: string[] = (t.security.subprocessors.headers ?? []).map(clean);
const rows: string[][] = (t.security.subprocessors.rows ?? []).map((r: string[]) => r.map(clean));
const note: string = clean(t.security.subprocessors.note);
---

<section class="subp">
  <div class="subp-inner">
    <h2 class="subp-h2">{title}</h2>
    <p class="subp-intro">{intro}</p>

    <div class="subp-table-wrap">
      <table class="subp-table">
        <thead>
          <tr>
            {headers.map((h) => (
              <th class="subp-th" scope="col">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              {row.map((cell) => (
                <td class="subp-td">{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="subp-note">{note}</p>
  </div>
</section>

<style>
  .subp {
    padding: clamp(64px, 8vw, 96px) 0;
  }

  .subp-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .subp-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(28px, 3.6vw, 44px);
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.12;
    text-wrap: balance;
  }

  .subp-intro {
    font-family: "Manrope", sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
    max-width: 56ch;
  }

  .subp-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--color-mist);
    border-radius: 10px;
  }

  .subp-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  .subp-th {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: left;
    color: var(--color-stone);
    padding: 14px 16px;
    background-color: color-mix(in srgb, var(--color-mist) 40%, transparent);
    border-bottom: 1px solid var(--color-mist);
  }

  .subp-td {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-charcoal);
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-mist);
  }

  .subp-table tbody tr:last-child .subp-td {
    border-bottom: none;
  }

  .subp-note {
    font-family: "Manrope", sans-serif;
    font-style: italic;
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  @media (max-width: 767px) {
    .subp {
      padding: 56px var(--gutter);
    }
  }
</style>
