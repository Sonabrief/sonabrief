---
interface Props {
  t: any;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const title: string = clean(t.security.promise.title);
const lines: string[] = (t.security.promise.lines ?? []).map(clean);
const link: string = clean(t.security.promise.link);

const setup = lines.slice(0, -1);
const punch = lines[lines.length - 1] ?? '';
---

<section class="promise">
  <div class="promise-inner">
    <p class="promise-eyebrow">{title}</p>

    <!-- apertura editoriale: le righe come affermazione grande, l'ultima
         ("Scegli tu.") come affondo. È la prima impressione della pagina. -->
    <div class="promise-lines">
      {setup.map((line) => (
        <p class="promise-line">{line}</p>
      ))}
      <p class="promise-line promise-line--punch">{punch}</p>
    </div>

    <a class="promise-link" href="#audio-section">{link}</a>
  </div>
</section>

<style>
  .promise {
    padding: clamp(96px, 12vw, 132px) 0 clamp(56px, 7vw, 80px);
  }

  .promise-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 36px;
  }

  .promise-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-stone);
    margin: 0;
  }

  .promise-lines {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 32ch;
  }

  .promise-line {
    font-family: var(--font-serif);
    font-weight: 400;
    font-optical-sizing: auto;
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--color-stone);
    margin: 0;
    text-wrap: pretty;
  }
  /* l'affondo: "Scegli tu." grande, teal */
  .promise-line--punch {
    font-weight: 500;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.05;
    color: var(--color-deep-teal);
    margin-top: 8px;
  }

  .promise-link {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-decoration-color: var(--color-mist);
    text-underline-offset: 4px;
    width: fit-content;
    transition: text-decoration-color 200ms var(--ease-out-cubic);
  }
  .promise-link:hover {
    text-decoration-color: var(--color-deep-teal);
  }
