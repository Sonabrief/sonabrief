---
interface Props {
  t: any;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}
const title: string = clean(t.security.early.title);
const body: string = clean(t.security.early.body);
---

<section class="early">
  <div class="early-inner">
    <h2 class="early-h2 reveal" data-reveal style="--i: 0">{title}</h2>
    <p class="early-body reveal" data-reveal style="--i: 1">{body}</p>
  </div>
</section>

<style>
  /* nota editoriale di chiusura: hairline sopra, testo onesto, contenuto */
  .early {
    padding: clamp(56px, 7vw, 80px) 0 clamp(96px, 11vw, 128px);
  }

  .early-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  /* il blocco testo vero, con hairline che lo stacca come epilogo */
  .early-inner {
    display: grid;
    grid-template-columns: minmax(0, 760px);
  }
  .early-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(22px, 2.8vw, 30px);
    letter-spacing: -0.01em;
    color: var(--color-deep-teal);
    margin: 0 0 16px;
    line-height: 1.16;
    padding-top: 32px;
    border-top: 1px solid var(--color-mist);
  }

  .early-body {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-stone);
    margin: 0;
    max-width: 62ch;
  }
</style>
