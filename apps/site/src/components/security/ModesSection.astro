---
interface Props {
  t: any;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const title: string = clean(t.security.modes.title);
const intro: string = clean(t.security.modes.intro);
const rawItems: { name: string; desc: string }[] = (t.security.modes.items ?? []).map(
  (m: { name: string; desc: string }) => ({ name: m.name, desc: clean(m.desc) })
);
const rawPerf = t.security.modes.performance;
const perf: { title: string; headers: string[]; rows: string[][] } = {
  title: clean(rawPerf.title),
  headers: (rawPerf.headers ?? []).map(clean),
  rows: (rawPerf.rows ?? []).map((r: string[]) => r.map(clean)),
};

// riordino per gradiente di privacy come in home (ThreeWays):
// Solo locale -> Standard -> Cloud Veloce. Riconosco la modalità dal nome (5 lingue).
function kindOf(name: string): 'local' | 'fast' | 'standard' {
  const n = name.toLowerCase();
  if (/local|locale|lokal|uniquement/.test(n)) return 'local';
  if (/veloce|fast|rapid|rápid|schnell/.test(n)) return 'fast';
  return 'standard';
}
const order: Record<string, number> = { local: 0, standard: 1, fast: 2 };
const items = [...rawItems].sort((a, b) => order[kindOf(a.name)] - order[kindOf(b.name)]);

// colore del bordo legato alla modalità (non alla posizione):
// local = Stone, standard = Mist, fast (Cloud) = Amber.
const borderByKind: Record<string, string> = {
  local: 'var(--color-stone)',
  standard: 'var(--color-mist)',
  fast: 'var(--color-amber)',
};

// The "Cloud Fast" column is the last column of the performance table.
const cloudColIndex = (perf?.headers?.length ?? 1) - 1;
---

<section class="modes">
  <div class="modes-inner">
    <h2 class="modes-h2 reveal" data-reveal style="--i: 0">{title}</h2>
    <p class="modes-intro reveal" data-reveal style="--i: 1">{intro}</p>

    <div class="modes-cards">
      {
        items.map((m, i) => (
          <div
            class="modes-card reveal"
            data-reveal
            style={`--i: ${i + 2}; border-left-color:${borderByKind[kindOf(m.name)] ?? 'var(--color-mist)'}`}
          >
            <p class="modes-card-name">{m.name}</p>
            <p class="modes-card-desc">{m.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="modes-table-wrap reveal" data-reveal style="--i: 5">
      <table class="modes-table">
        <caption class="modes-table-caption">{perf.title}</caption>
        <thead>
          <tr>
            {perf.headers.map((h, i) => (
              <th class:list={['modes-th', { 'modes-col-cloud': i === cloudColIndex }]} scope="col">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {perf.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                <td class:list={['modes-td', { 'modes-col-cloud': i === cloudColIndex }]}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .modes {
    padding: clamp(64px, 8vw, 96px) 0;
  }

  .modes-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .modes-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(28px, 3.6vw, 44px);
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.12;
    text-wrap: balance;
  }

  .modes-intro {
    font-family: "Manrope", sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
    max-width: 56ch;
  }

  .modes-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .modes-card {
    border-left: 3px solid var(--color-mist);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .modes-card-name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: 20px;
    color: var(--color-deep-teal);
    margin: 0;
  }

  .modes-card-desc {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  .modes-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .modes-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
  }

  .modes-table-caption {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-stone);
    text-align: left;
    margin-bottom: 12px;
  }

  .modes-th {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-stone);
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-mist);
  }

  .modes-td {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-charcoal);
    padding: 12px 14px;
    border-bottom: 1px solid var(--color-mist);
  }

  .modes-col-cloud {
    background-color: color-mix(in srgb, var(--color-amber) 8%, transparent);
  }

  @media (max-width: 767px) {
    .modes {
      padding: 56px var(--gutter);
    }
  }
</style>
