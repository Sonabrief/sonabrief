---
interface Props {
  t: any;
}
const { t } = Astro.props;

const title: string = t.security.modes.title;
const intro: string = t.security.modes.intro;
const items: { name: string; desc: string }[] = t.security.modes.items ?? [];
const perf: { title: string; headers: string[]; rows: string[][] } = t.security.modes.performance;

// border colors in declared order: Standard = Mist, Local = Stone, Cloud = Amber
const borderColors = ['var(--color-mist)', 'var(--color-stone)', 'var(--color-amber)'];

// The "Cloud Fast" column is the last column of the performance table.
const cloudColIndex = (perf?.headers?.length ?? 1) - 1;
---

<section class="modes">
  <div class="modes-inner">
    <h2 class="modes-h2">{title}</h2>
    <p class="modes-intro">{intro}</p>

    <div class="modes-cards">
      {
        items.map((m, i) => (
          <div class="modes-card" style={`border-left-color:${borderColors[i] ?? 'var(--color-mist)'}`}>
            <p class="modes-card-name">{m.name}</p>
            <p class="modes-card-desc">{m.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="modes-table-wrap">
      <table class="modes-table">
        <caption class="modes-table-caption">{perf.title}</caption>
        <thead>
          <tr>
            {perf.headers.map((h, i) => (
              <th class:list={['modes-th', { 'modes-col-cloud': i === cloudColIndex }]} scope="col">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {perf.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                <td class:list={['modes-td', { 'modes-col-cloud': i === cloudColIndex }]}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .modes {
    padding: 80px 24px;
  }

  .modes-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .modes-h2 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.2;
  }

  .modes-intro {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-stone);
    margin: 0;
  }

  .modes-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .modes-card {
    border-left: 3px solid var(--color-mist);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .modes-card-name {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-deep-teal);
    margin: 0;
  }

  .modes-card-desc {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  .modes-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .modes-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
  }

  .modes-table-caption {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-stone);
    text-align: left;
    margin-bottom: 12px;
  }

  .modes-th {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-stone);
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-mist);
  }

  .modes-td {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-charcoal);
    padding: 12px 14px;
    border-bottom: 1px solid var(--color-mist);
  }

  .modes-col-cloud {
    background-color: color-mix(in srgb, var(--color-amber) 8%, transparent);
  }

  @media (max-width: 767px) {
    .modes {
      padding: 56px 24px;
    }
  }
</style>
