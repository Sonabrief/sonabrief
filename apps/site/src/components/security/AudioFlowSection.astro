---
interface Props {
  t: any;
}
const { t } = Astro.props;

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const title: string = clean(t.security.audio.title);
const flow: string[] = (t.security.audio.flow ?? []).map(clean);
const body: string = clean(t.security.audio.body);
const codeNote: string = clean(t.security.audio.codeNote);
const codeLink: string = clean(t.security.audio.codeLink);

const codeHref =
  'https://github.com/Sonabrief/sonabrief/blob/main/apps/web/src/lib/chunkStore.ts#L86-L90';
---

<section class="audio" id="audio-section">
  <div class="audio-inner">
    <h2 class="audio-h2">{title}</h2>

    <!-- flusso VERTICALE a scendere: ogni passo su una riga, connettore verticale,
         l'ultimo step ("zero audio residuo") chiude evidenziato. Più leggibile dei
         box orizzontali per un flusso sequenziale su pagina critica. -->
    <ol class="audio-flow" role="list" aria-label={flow.join(' → ')}>
      {flow.map((step, i) => (
        <li
          class:list={['audio-step fade-up', { 'audio-step--final': i === flow.length - 1 }]}
          data-audio-box
          style={`transition-delay:${i * 120}ms`}
        >
          <span class="audio-marker" aria-hidden="true">
            <span class="audio-dot"></span>
          </span>
          <span class="audio-step-text">{step}</span>
        </li>
      ))}
    </ol>

    <p class="audio-body">{body}</p>
    <p class="audio-codenote">{codeNote}</p>
    <a class="audio-codelink" href={codeHref} target="_blank" rel="noopener noreferrer">{codeLink}</a>
  </div>
</section>

<style>
  .audio {
    padding: 88px 24px;
  }

  .audio-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .audio-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(26px, 3.4vw, 40px);
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.14;
    text-wrap: balance;
  }

  /* flusso verticale a scendere */
  .audio-flow {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .audio-step {
    position: relative;
    display: grid;
    grid-template-columns: 28px 1fr;
    column-gap: 18px;
    align-items: start;
    padding-bottom: 28px;
  }
  .audio-step:last-child {
    padding-bottom: 0;
  }

  /* marker + linea verticale di connessione a scendere */
  .audio-marker {
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 5px;
    height: 100%;
  }
  .audio-dot {
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    border: 1.5px solid var(--color-deep-teal);
    background-color: var(--color-cream);
    flex-shrink: 0;
    z-index: 1;
  }
  .audio-step:not(:last-child) .audio-marker::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 18px;
    bottom: -28px;
    width: 1px;
    transform: translateX(-50%);
    background-color: var(--color-mist);
  }
  /* l'ultimo step: dot pieno teal, il flusso si chiude */
  .audio-step--final .audio-dot {
    background-color: var(--color-deep-teal);
  }

  .audio-step-text {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-charcoal);
    padding-top: 1px;
  }
  .audio-step--final .audio-step-text {
    font-weight: 600;
    color: var(--color-deep-teal);
  }

  .audio-body {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-stone);
    margin: 0;
    max-width: 680px;
  }
  .audio-codenote {
    font-family: "Manrope", sans-serif;
    font-style: italic;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }
  .audio-codelink {
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    color: var(--color-deep-teal);
    text-decoration: underline;
    text-decoration-color: var(--color-mist);
    text-underline-offset: 4px;
    width: fit-content;
    transition: text-decoration-color 200ms var(--ease-out-cubic);
  }
  .audio-codelink:hover {
    text-decoration-color: var(--color-deep-teal);
  }

  @media (max-width: 767px) {
    .audio {
      padding: 56px 24px;
    }
  }
</style>

<script>
  const boxes = document.querySelectorAll<HTMLElement>('#audio-section [data-audio-box]');
  if ('IntersectionObserver' in window && boxes.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    boxes.forEach((box) => observer.observe(box));
  } else {
    boxes.forEach((box) => box.classList.add('visible'));
  }
</script>
