---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

const e = t.pricing.enterprise ?? {};
const form = e.form ?? {};
---

<section class="pe">
  <div class="pe-inner">
    <div class="pe-card reveal" data-reveal style="--i: 0">
      <h2 class="pe-h2">{e.heading}</h2>
      <p class="pe-body">{e.body}</p>

      <form
        class="pe-form"
        id="enterprise-form"
      >
        <div class="pe-field">
          <label for="pe-name" class="pe-label">{form.name}</label>
          <input id="pe-name" name="name" type="text" class="pe-input" required />
        </div>
        <div class="pe-field">
          <label for="pe-email" class="pe-label">{form.email}</label>
          <input id="pe-email" name="email" type="email" class="pe-input" required />
        </div>
        <div class="pe-field">
          <label for="pe-notes" class="pe-label">{form.notes}</label>
          <textarea id="pe-notes" name="notes" class="pe-textarea" rows="4"></textarea>
        </div>
        <button type="submit" class="pe-submit" data-label={form.submit ?? e.cta}>{form.submit ?? e.cta}</button>
      </form>
    </div>
  </div>
</section>

<style>
  .pe {
    padding: 48px 0 clamp(80px, 9vw, 96px);
  }

  .pe-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .pe-card {
    background-color: color-mix(in srgb, var(--color-mist) 55%, var(--color-cream));
    border: 1px solid var(--color-mist);
    border-radius: 20px;
    padding: clamp(28px, 4vw, 48px);
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pe-h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(26px, 3.4vw, 40px);
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.14;
  }

  .pe-body {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0 0 16px;
  }

  .pe-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pe-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pe-label {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-stone);
  }

  .pe-input,
  .pe-textarea {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--color-charcoal);
    background-color: var(--color-cream);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
    padding: 12px 14px;
    outline: none;
    transition: border-color 150ms ease;
  }

  .pe-textarea {
    resize: vertical;
    min-height: 96px;
    font-family: "Manrope", sans-serif;
  }

  .pe-input:focus,
  .pe-textarea:focus {
    border-color: var(--color-deep-teal);
  }

  .pe-submit {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-cream);
    background-color: var(--color-deep-teal);
    border: none;
    padding: 12px 24px;
    border-radius: 9999px;
    cursor: pointer;
    align-self: flex-start;
    transition:
      opacity 200ms var(--ease-out-cubic),
      transform 200ms var(--ease-out-cubic);
  }

  .pe-submit:hover {
    opacity: 0.94;
    transform: translateY(-1px);
  }
  .pe-submit:active {
    transform: translateY(1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .pe-submit:hover,
    .pe-submit:active {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .pe {
      padding: 32px 16px 64px;
    }
    .pe-card {
      padding: 32px 24px;
    }
  }
</style>

<script>
  const form = document.getElementById('enterprise-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const target = e.target as HTMLFormElement;
      const btn = target.querySelector<HTMLButtonElement>('[type=submit]');
      if (!btn) return;
      btn.disabled = true;
      btn.textContent = '...';
      try {
        const res = await fetch('/api/enterprise-contact', {
          method: 'POST',
          body: new FormData(target),
        });
        const json = await res.json();
        if (json.ok) {
          target.innerHTML = '<p style="color:var(--color-deep-teal);font-family:Manrope">✓ Message sent. We will be in touch within 48 hours.</p>';
        } else {
          btn.disabled = false;
          btn.textContent = btn.dataset.label ?? 'Send';
          alert('Something went wrong. Please email hello@sonabrief.com directly.');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = btn.dataset.label ?? 'Send';
        alert('Something went wrong. Please email hello@sonabrief.com directly.');
      }
    });
  }
</script>
