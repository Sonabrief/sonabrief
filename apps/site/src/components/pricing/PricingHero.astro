---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface Tier {
  name: string;
  price: string;
  priceAnnual?: string;
  period?: string;
  highlights?: string[];
  cta: string;
}

const tiers: Tier[] = t.pricing.tiers ?? [];

function ctaHref(name: string): string {
  if (/enterprise/i.test(name)) return 'mailto:hello@sonabrief.com';
  return 'https://app.sonabrief.com/';
}

function ctaVariant(name: string, index: number): 'solid' | 'outline-teal' | 'outline-stone' {
  if (/enterprise/i.test(name)) return 'outline-stone';
  if (index === 2) return 'solid';
  return 'outline-teal';
}
---

<section class="ph">
  <div class="ph-inner">
    <h1 class="ph-h1">{t.pricing.title}</h1>

    <div class="ph-toggle-row">
      <div class="ph-toggle" role="tablist" aria-label="Billing period">
        <button
          type="button"
          class="ph-toggle-btn active"
          data-toggle="monthly"
          aria-pressed="true"
        >
          {t.pricing.toggle?.monthly ?? 'Monthly'}
        </button>
        <button
          type="button"
          class="ph-toggle-btn"
          data-toggle="annual"
          aria-pressed="false"
        >
          {t.pricing.toggle?.annual ?? 'Annual'}
        </button>
      </div>
      {t.pricing.toggle?.annualNote && (
        <span class="ph-badge" id="annual-badge">{t.pricing.toggle.annualNote}</span>
      )}
    </div>

    <div class="ph-cards">
      {tiers.map((tier, i) => {
        const variant = ctaVariant(tier.name, i);
        const hasAnnual = !!tier.priceAnnual;
        return (
          <div class:list={['ph-card', { 'ph-card--highlighted': i === 2 }]}>
            <p class="ph-card-name">{tier.name}</p>

            <div class="ph-card-price-row">
              {hasAnnual ? (
                <>
                  <span class="ph-card-price" data-price-monthly>{tier.price}</span>
                  <span class="ph-card-price" data-price-annual style="display:none">{tier.priceAnnual}</span>
                </>
              ) : (
                <span class="ph-card-price">{tier.price}</span>
              )}
              {tier.period && <span class="ph-card-period">{tier.period}</span>}
            </div>

            <a
              href={ctaHref(tier.name)}
              class:list={['ph-card-cta', `ph-card-cta--${variant}`]}
            >
              {tier.cta}
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .ph {
    padding: 120px 24px 48px;
  }

  .ph-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
    text-align: center;
  }

  .ph-h1 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-deep-teal);
    line-height: 1.15;
    margin: 0;
  }

  .ph-toggle-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ph-toggle {
    display: inline-flex;
    border: 1px solid var(--color-mist);
    border-radius: 9999px;
    padding: 4px;
    gap: 4px;
  }

  .ph-toggle-btn {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 20px;
    border: none;
    background: transparent;
    color: var(--color-stone);
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  .ph-toggle-btn.active {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
  }

  .ph-badge {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-amber);
    border: 1px solid var(--color-amber);
    padding: 6px 12px;
    border-radius: 9999px;
    display: none;
  }

  .ph-cards {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 16px;
  }

  .ph-card {
    border: 1px solid var(--color-mist);
    border-radius: 16px;
    padding: 24px;
    background-color: var(--color-cream);
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }

  .ph-card--highlighted {
    border: 2px solid var(--color-deep-teal);
    background-color: #ffffff;
  }

  .ph-card-name {
    font-family: "Manrope", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-stone);
    margin: 0;
  }

  .ph-card-price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }

  .ph-card-price {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 40px;
    font-weight: 700;
    color: var(--color-deep-teal);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ph-card-period {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--color-stone);
  }

  .ph-card-cta {
    display: block;
    width: 100%;
    text-align: center;
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 20px;
    border-radius: 9999px;
    text-decoration: none;
    border: 1.5px solid var(--color-deep-teal);
    box-sizing: border-box;
    margin-top: auto;
    transition: background-color 150ms ease, color 150ms ease, opacity 150ms ease;
  }

  .ph-card-cta--outline-teal {
    color: var(--color-deep-teal);
    background: transparent;
    border-color: var(--color-deep-teal);
  }

  .ph-card-cta--outline-teal:hover {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
  }

  .ph-card-cta--solid {
    color: var(--color-cream);
    background-color: var(--color-deep-teal);
    border-color: var(--color-deep-teal);
  }

  .ph-card-cta--solid:hover {
    opacity: 0.88;
  }

  .ph-card-cta--outline-stone {
    color: var(--color-stone);
    background: transparent;
    border-color: var(--color-stone);
  }

  .ph-card-cta--outline-stone:hover {
    background-color: var(--color-stone);
    color: var(--color-cream);
  }

  @media (max-width: 1023px) {
    .ph-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .ph {
      padding: 80px 24px 32px;
    }
    .ph-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.toggle;
      if (!mode) return;

      document.querySelectorAll<HTMLElement>('[data-price-monthly]').forEach((el) => {
        el.style.display = mode === 'monthly' ? '' : 'none';
      });
      document.querySelectorAll<HTMLElement>('[data-price-annual]').forEach((el) => {
        el.style.display = mode === 'annual' ? '' : 'none';
      });

      document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((b) => {
        const active = b.dataset.toggle === mode;
        b.classList.toggle('active', active);
        b.setAttribute('aria-pressed', String(active));
      });

      const badge = document.getElementById('annual-badge');
      if (badge) badge.style.display = mode === 'annual' ? 'inline-block' : 'none';
    });
  });
</script>
