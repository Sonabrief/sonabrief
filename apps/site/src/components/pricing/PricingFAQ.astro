---
import AccordionFAQ from '../AccordionFAQ.astro';

interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface FAQEntry {
  q: string;
  a: string;
}

const rawItems: FAQEntry[] = t.pricing.faq?.items ?? [];
const items = rawItems.map((it) => ({ question: it.q, answer: it.a }));
const title: string = t.pricing.faq?.title ?? '';
---

<section class="pfaq">
  <div class="pfaq-inner">
    <h2 class="pfaq-title reveal" data-reveal style="--i: 0">{title}</h2>
    <AccordionFAQ items={items} />
  </div>
</section>

<style>
  .pfaq {
    padding: clamp(72px, 9vw, 96px) 0 clamp(96px, 11vw, 120px);
  }

  .pfaq-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pfaq-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(28px, 3.6vw, 44px);
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.12;
    max-width: 22ch;
    text-wrap: balance;
  }

  @media (max-width: 767px) {
    .pfaq {
      padding: 64px 24px 80px;
    }
  }
</style>
