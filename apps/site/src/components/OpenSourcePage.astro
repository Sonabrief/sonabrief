---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface OSSection {
  title: string;
  body: string;
}

function clean(s: string): string {
  return s.replace(/(\d)\s*[—–]\s*(\d)/g, '$1-$2').replace(/\s*[—–]\s*/g, ', ');
}

const intro: string = clean(t.openSourcePage?.intro ?? '');
const rawSections: OSSection[] = t.openSourcePage?.sections ?? [];
const sections = rawSections.map((s) => ({ title: clean(s.title), body: clean(s.body) }));
const repo: string = t.openSourcePage?.repo ?? '';
const cta: string = clean(t.openSourcePage?.cta ?? '');
---

<section class="osp">
  <div class="osp-inner">
    {intro && (
      <p class="osp-intro fade-up" data-osp-section>{intro}</p>
    )}

    <!-- sezioni come split editoriale: titolo serif a sinistra, body a destra.
         Layout-family diversa da /about (numeri a margine) e dalla sezione
         OpenSource scura in home (chip teal). -->
    <div class="osp-sections">
      {sections.map((s) => (
        <article class="osp-section fade-up" data-osp-section>
          <h3 class="osp-h3">{s.title}</h3>
          <p class="osp-body">{s.body}</p>
        </article>
      ))}
    </div>

    <div class="osp-repo fade-up" data-osp-section>
      <code class="osp-repo-text">{repo}</code>
      <a href="https://github.com/sonabrief/sonabrief" class="osp-cta" target="_blank" rel="noopener noreferrer">
        {cta}
      </a>
    </div>
  </div>
</section>

<style>
  .osp {
    padding: clamp(96px, 12vw, 132px) 0 clamp(80px, 10vw, 120px);
  }

  .osp-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 6vw, 72px);
  }

  /* intro come apertura editoriale grande */
  .osp-intro {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.14;
    letter-spacing: -0.015em;
    color: var(--color-deep-teal);
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
  }

  .osp-sections {
    display: flex;
    flex-direction: column;
  }

  /* split: titolo serif a sinistra, body a destra */
  .osp-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    column-gap: clamp(40px, 6vw, 80px);
    align-items: start;
    padding: 36px 0;
    border-top: 1px solid var(--color-mist);
  }
  .osp-section:last-child {
    border-bottom: 1px solid var(--color-mist);
  }

  .osp-h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: clamp(20px, 2.4vw, 28px);
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .osp-body {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-stone);
    margin: 0;
    max-width: 60ch;
  }

  /* repo + CTA: chiusura, riga con codice mono e bottone */
  .osp-repo {
    display: flex;
    align-items: center;
    gap: 16px 24px;
    border: 1.5px solid var(--color-deep-teal);
    border-radius: 14px;
    padding: 18px 20px;
    flex-wrap: wrap;
    background-color: color-mix(in srgb, var(--color-deep-teal) 4%, var(--color-cream));
  }

  .osp-repo-text {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-charcoal);
    flex: 1;
    min-width: 200px;
  }

  .osp-cta {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-cream);
    background-color: var(--color-deep-teal);
    padding: 11px 22px;
    border-radius: 9999px;
    text-decoration: none;
    transition:
      opacity 200ms var(--ease-out-cubic),
      transform 200ms var(--ease-out-cubic);
  }
  .osp-cta:hover {
    opacity: 0.9;
  }
  .osp-cta:active {
    transform: translateY(1px);
  }

  /* reveal */
  [data-osp-section] {
    opacity: 0;
    transform: translateY(var(--reveal-distance));
    transition:
      opacity 600ms var(--ease-out-cubic),
      transform 600ms var(--ease-out-cubic);
  }
  [data-osp-section].visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-osp-section] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .osp-section {
      grid-template-columns: 1fr;
      row-gap: 12px;
      padding: 32px 0;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-osp-section]');
  if ('IntersectionObserver' in window && items.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('visible'));
  }
</script>
