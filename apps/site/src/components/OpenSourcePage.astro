---
interface Props {
  t: any;
  lang: string;
}
const { t } = Astro.props;

interface OSSection {
  title: string;
  body: string;
}

const intro: string = t.openSourcePage?.intro ?? '';
const sections: OSSection[] = t.openSourcePage?.sections ?? [];
const repo: string = t.openSourcePage?.repo ?? '';
const cta: string = t.openSourcePage?.cta ?? '';
---

<section class="osp">
  <div class="osp-inner">
    {intro && (
      <p class="osp-intro fade-up" data-osp-section>{intro}</p>
    )}

    {sections.map((s) => (
      <div class="osp-section fade-up" data-osp-section>
        <h3 class="osp-h3">{s.title}</h3>
        <p class="osp-body">{s.body}</p>
      </div>
    ))}

    <div class="osp-repo fade-up" data-osp-section>
      <code class="osp-repo-text">{repo}</code>
      <a href="https://github.com/sonabrief/sonabrief" class="osp-cta" target="_blank" rel="noopener noreferrer">
        {cta}
      </a>
    </div>
  </div>
</section>

<style>
  .osp {
    padding: 120px 24px;
  }

  .osp-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .osp-intro {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-deep-teal);
    margin: 0;
    max-width: 60ch;
  }

  .osp-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .osp-h3 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--color-deep-teal);
    margin: 0;
    line-height: 1.3;
  }

  .osp-body {
    font-family: "Manrope", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-stone);
    margin: 0;
    max-width: 65ch;
  }

  .osp-repo {
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1.5px solid var(--color-deep-teal);
    border-radius: 12px;
    padding: 16px;
    flex-wrap: wrap;
  }

  .osp-repo-text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 14px;
    color: var(--color-charcoal);
    flex: 1;
    min-width: 200px;
  }

  .osp-cta {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-cream);
    background-color: var(--color-deep-teal);
    padding: 10px 20px;
    border-radius: 9999px;
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .osp-cta:hover {
    opacity: 0.88;
  }

  @media (max-width: 767px) {
    .osp {
      padding: 80px 24px;
    }
    .osp-inner {
      gap: 40px;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-osp-section]');
  if ('IntersectionObserver' in window && items.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('visible'));
  }
</script>
