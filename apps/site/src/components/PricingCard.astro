---
interface Props {
  name: string;
  price: string;
  period: string;
  description: string;
  features: string[];
  cta: string;
  ctaHref: string;
  // gerarchia a 3 livelli: none (Free/Enterprise/Pro Unlimited), soft (amber
  // tenue), strong (Pro, teal pieno = piano-ancora consigliato).
  emphasis?: 'none' | 'soft' | 'strong';
  // badge "Più scelto" (solo su Pro). Vuoto = nessun badge.
  badge?: string;
}

const {
  name,
  price,
  period,
  description,
  features,
  cta,
  ctaHref,
  emphasis = 'none',
  badge = '',
} = Astro.props;
---

<div
  class:list={[
    'pricing-card',
    { 'pricing-card--soft': emphasis === 'soft', 'pricing-card--strong': emphasis === 'strong' },
  ]}
>
  {badge && <span class="pricing-card-badge">{badge}</span>}
  <p class="pricing-card-name">{name}</p>

  <div class="pricing-card-price-row">
    <span class="pricing-card-price">{price}</span>
    {period && <span class="pricing-card-period">{period}</span>}
  </div>

  {description && <p class="pricing-card-description">{description}</p>}

  <ul class="pricing-card-features">
    {features.map((feature) => (
      <li>{feature}</li>
    ))}
  </ul>

  <a
    href={ctaHref}
    class:list={[
      'pricing-card-cta',
      { 'pricing-card-cta--soft': emphasis === 'soft', 'pricing-card-cta--strong': emphasis === 'strong' },
    ]}
    plausible-event-name={ctaHref.includes('app.sonabrief.com') ? 'CTA: Try free' : undefined}
  >
    {cta}
  </a>
</div>

<style>
  .pricing-card {
    position: relative;
    border: 1px solid var(--color-mist);
    border-radius: 16px;
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    gap: 0;
    background-color: transparent;
  }

  /* badge "Più scelto": pill ambra centrata sul bordo alto, come app /pricing */
  .pricing-card-badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: "Manrope", sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-cream);
    background-color: var(--color-amber);
    padding: 5px 14px;
    border-radius: 9999px;
    white-space: nowrap;
  }

  /* gerarchia a 3 livelli, solo colori brand, niente badge.
     soft (Pro): bordo + sfondo amber tenue, risalto morbido. */
  .pricing-card--soft {
    border: 1.5px solid color-mix(in srgb, var(--color-amber) 55%, var(--color-mist));
    background-color: color-mix(in srgb, var(--color-amber) 7%, transparent);
  }
  /* strong (Pro Unlimited): teal pieno, il più appariscente. */
  .pricing-card--strong {
    border: 1.5px solid var(--color-deep-teal);
    background-color: color-mix(in srgb, var(--color-deep-teal) 6%, transparent);
  }

  /* nome tier in mono — coerente col register dati */
  .pricing-card-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-stone);
    margin: 0 0 18px;
  }

  .pricing-card-price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 24px;
  }

  /* il prezzo è il momento: serif grande */
  .pricing-card-price {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: 46px;
    color: var(--color-deep-teal);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .pricing-card-period {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-stone);
  }

  .pricing-card-description {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--color-stone);
    line-height: 1.6;
    margin: 0 0 24px;
  }

  /* feature senza bullet: hairline tra le righe, register editoriale */
  .pricing-card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .pricing-card-features li {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-charcoal);
    padding: 11px 0;
    border-top: 1px solid var(--color-mist);
  }
  .pricing-card-features li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .pricing-card-cta {
    display: block;
    width: 100%;
    /* ancorata in fondo: con .pricing-card-features { flex:1 } la CTA resta
       in basso, allineata tra card di altezza uguale anche con liste diverse. */
    margin-top: auto;
    text-align: center;
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 20px;
    border-radius: 9999px;
    text-decoration: none;
    border: 1.5px solid var(--color-deep-teal);
    color: var(--color-deep-teal);
    background: transparent;
    transition:
      background-color 200ms var(--ease-out-cubic),
      color 200ms var(--ease-out-cubic),
      transform 200ms var(--ease-out-cubic);
    box-sizing: border-box;
  }

  .pricing-card-cta:hover {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
  }
  .pricing-card-cta:active {
    transform: translateY(1px);
  }

  /* soft (Pro): CTA outline amber, si riempie amber su hover */
  .pricing-card-cta--soft {
    border-color: var(--color-amber);
    color: color-mix(in srgb, var(--color-amber) 75%, var(--color-charcoal));
  }
  .pricing-card-cta--soft:hover {
    background-color: var(--color-amber);
    color: var(--color-charcoal);
  }

  /* strong (Pro Unlimited): CTA teal pieno, il più appariscente */
  .pricing-card-cta--strong {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
    border-color: var(--color-deep-teal);
  }
  .pricing-card-cta--strong:hover {
    opacity: 0.9;
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
  }
</style>
