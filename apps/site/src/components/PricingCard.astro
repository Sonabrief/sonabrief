---
interface Props {
  name: string;
  price: string;
  period: string;
  description: string;
  features: string[];
  cta: string;
  ctaHref: string;
  highlighted?: boolean;
}

const {
  name,
  price,
  period,
  description,
  features,
  cta,
  ctaHref,
  highlighted = false,
} = Astro.props;
---

<div class:list={['pricing-card', { 'pricing-card--highlighted': highlighted }]}>
  <p class="pricing-card-name">{name}</p>

  <div class="pricing-card-price-row">
    <span class="pricing-card-price">{price}</span>
    {period && <span class="pricing-card-period">{period}</span>}
  </div>

  {description && <p class="pricing-card-description">{description}</p>}

  <ul class="pricing-card-features">
    {features.map((feature) => (
      <li>{feature}</li>
    ))}
  </ul>

  <a
    href={ctaHref}
    class:list={['pricing-card-cta', { 'pricing-card-cta--highlighted': highlighted }]}
    plausible-event-name={ctaHref.includes('app.sonabrief.com') ? 'CTA: Try free' : undefined}
  >
    {cta}
  </a>
</div>

<style>
  .pricing-card {
    border: 1px solid var(--color-mist);
    border-radius: 16px;
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    gap: 0;
    background-color: transparent;
  }

  /* tier consigliato: bordo teal pieno, leggero rialzo cromatico */
  .pricing-card--highlighted {
    border: 1.5px solid var(--color-deep-teal);
    background-color: color-mix(in srgb, var(--color-deep-teal) 4%, transparent);
  }

  /* nome tier in mono — coerente col register dati */
  .pricing-card-name {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-stone);
    margin: 0 0 18px;
  }

  .pricing-card-price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 24px;
  }

  /* il prezzo è il momento: serif grande */
  .pricing-card-price {
    font-family: var(--font-serif);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: 46px;
    color: var(--color-deep-teal);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .pricing-card-period {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-stone);
  }

  .pricing-card-description {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    color: var(--color-stone);
    line-height: 1.6;
    margin: 0 0 24px;
  }

  /* feature senza bullet: hairline tra le righe, register editoriale */
  .pricing-card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .pricing-card-features li {
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-charcoal);
    padding: 11px 0;
    border-top: 1px solid var(--color-mist);
  }
  .pricing-card-features li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .pricing-card-cta {
    display: block;
    width: 100%;
    text-align: center;
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 20px;
    border-radius: 9999px;
    text-decoration: none;
    border: 1.5px solid var(--color-deep-teal);
    color: var(--color-deep-teal);
    background: transparent;
    transition:
      background-color 200ms var(--ease-out-cubic),
      color 200ms var(--ease-out-cubic),
      transform 200ms var(--ease-out-cubic);
    box-sizing: border-box;
  }

  .pricing-card-cta:hover {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
  }
  .pricing-card-cta:active {
    transform: translateY(1px);
  }

  .pricing-card-cta--highlighted {
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
    border-color: var(--color-deep-teal);
  }

  .pricing-card-cta--highlighted:hover {
    opacity: 0.88;
    background-color: var(--color-deep-teal);
    color: var(--color-cream);
  }
</style>
