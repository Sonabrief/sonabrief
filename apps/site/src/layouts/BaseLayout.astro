---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  currentPath?: string;
  /** Path to the social share image, relative to site root. */
  ogImage?: string;
  /** Open Graph object type. */
  ogType?: 'website' | 'article';
  /** Emit <meta name="robots" content="noindex"> (use on 404, redirect pages). */
  noindex?: boolean;
  /**
   * Override the hreflang alternates. Defaults to the 5 fixed site languages.
   * pSEO pages pass only the languages an entry is actually translated into,
   * so we never advertise an alternate that 404s. Shape: [{ lang, href }].
   * x-default is derived from whichever entry has lang === 'en'.
   */
  hreflangAlternates?: { lang: string; href: string }[];
}

const {
  title = 'Sonabrief',
  description = 'Open-source meeting assistant. Audio never leaves your computer.',
  lang = 'en',
  currentPath = '',
  ogImage = '/og.png',
  ogType = 'website',
  noindex = false,
  hreflangAlternates,
} = Astro.props;

const base = 'https://sonabrief.com';
const path = currentPath ? `${currentPath}/`.replace(/\/\/$/, '/') : '';
// For en the canonical lives at the root (no /en/ prefix); other langs are prefixed.
const langPath = lang === 'en' ? `${base}/${path}` : `${base}/${lang}/${path}`;
const canonical = langPath;
const ogImageUrl = new URL(ogImage, base).href;

// Default: the 5 fixed site languages (every standard page is fully localized).
// pSEO pages pass `hreflangAlternates` with only the translated languages.
const hreflangs = hreflangAlternates ?? [
  { lang: 'en', href: `${base}/${path}` },
  { lang: 'it', href: `${base}/it/${path}` },
  { lang: 'fr', href: `${base}/fr/${path}` },
  { lang: 'es', href: `${base}/es/${path}` },
  { lang: 'de', href: `${base}/de/${path}` },
];

// x-default points at the EN alternate when present, else the first one.
const xDefaultHref =
  hreflangs.find((h) => h.lang === 'en')?.href ?? hreflangs[0]?.href ?? `${base}/${path}`;

const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  it: 'it_IT',
  fr: 'fr_FR',
  es: 'es_ES',
  de: 'de_DE',
};
const ogLocale = ogLocaleMap[lang] ?? 'en_US';
const ogLocaleAlternates = Object.values(ogLocaleMap).filter((l) => l !== ogLocale);

// Structured data: brand + the product, surfaced on every page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${base}/#organization`,
      name: 'Sonabrief',
      url: base,
      logo: `${base}/logo.svg`,
      sameAs: ['https://github.com/sonabrief/sonabrief'],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${base}/#software`,
      name: 'Sonabrief',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'macOS, Windows, Linux, Web',
      url: base,
      description,
      publisher: { '@id': `${base}/#organization` },
      offers: [
        { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'EUR' },
        { '@type': 'Offer', name: 'Pro', price: '9', priceCurrency: 'EUR' },
        { '@type': 'Offer', name: 'Pro Unlimited', price: '19', priceCurrency: 'EUR' },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>

    <link rel="canonical" href={canonical} />

    {hreflangs.map(({ lang: l, href }) => (
      <link rel="alternate" hreflang={l} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sonabrief" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Structured data */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script defer data-domain="sonabrief.com,app.sonabrief.com" src="https://plausible.io/js/script.hash.js"></script>
    <!-- data-api="/api/event" --><!-- uncomment to proxy events and bypass ad-blockers -->
  </head>
  <body class="grain-texture">
    <Navbar lang={lang} />
    <slot />
    <Footer currentLang={lang} currentPath={currentPath} />

    <script>
      // Observer reveal globale: aggancia ogni .reveal[data-reveal] della pagina
      // e aggiunge .is-in quando entra in viewport. Idempotente (se un componente
      // ha già il suo observer, aggiungere is-in due volte è un no-op).
      // reduced-motion è gestito in CSS (.reveal collassa a visibile).
      (() => {
        const els = document.querySelectorAll<HTMLElement>('.reveal[data-reveal]:not(.is-in)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => obs.observe(el));
      })();
    </script>
  </body>
</html>
