---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  currentPath?: string;
}

const {
  title = 'Sonabrief',
  description = 'Open-source meeting assistant. Audio never leaves your computer.',
  lang = 'en',
  currentPath = '',
} = Astro.props;

const base = 'https://sonabrief.com';
const path = currentPath ? `${currentPath}/`.replace(/\/\/$/, '/') : '';
const hreflangs = [
  { lang: 'en', href: `${base}/${path}` },
  { lang: 'it', href: `${base}/it/${path}` },
  { lang: 'fr', href: `${base}/fr/${path}` },
  { lang: 'es', href: `${base}/es/${path}` },
  { lang: 'de', href: `${base}/de/${path}` },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
<title>{title}</title>

    <link rel="canonical" href={`${base}/${path}`} />

    {hreflangs.map(({ lang: l, href }) => (
      <link rel="alternate" hreflang={l} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${base}/${path}`} />

    <script defer data-domain="sonabrief.com,app.sonabrief.com" src="https://plausible.io/js/script.hash.js"></script>
    <!-- data-api="/api/event" --><!-- uncomment to proxy events and bypass ad-blockers -->
  </head>
  <body class="grain-texture">
    <Navbar lang={lang} />
    <slot />
    <Footer currentLang={lang} currentPath={currentPath} />

    <script>
      // Observer reveal globale: aggancia ogni .reveal[data-reveal] della pagina
      // e aggiunge .is-in quando entra in viewport. Idempotente (se un componente
      // ha già il suo observer, aggiungere is-in due volte è un no-op).
      // reduced-motion è gestito in CSS (.reveal collassa a visibile).
      (() => {
        const els = document.querySelectorAll<HTMLElement>('.reveal[data-reveal]:not(.is-in)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => obs.observe(el));
      })();
    </script>
  </body>
</html>
