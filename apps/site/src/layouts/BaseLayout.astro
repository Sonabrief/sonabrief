---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'Sonabrief',
  description = 'Open-source meeting assistant. Audio never leaves your computer.',
  lang = 'en',
} = Astro.props;

const hreflangs = [
  { lang: 'en', href: 'https://sonabrief.com/' },
  { lang: 'it', href: 'https://sonabrief.com/it/' },
  { lang: 'fr', href: 'https://sonabrief.com/fr/' },
  { lang: 'es', href: 'https://sonabrief.com/es/' },
  { lang: 'de', href: 'https://sonabrief.com/de/' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>

    {hreflangs.map(({ lang: l, href }) => (
      <link rel="alternate" hreflang={l} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://sonabrief.com/" />

    <script defer data-domain="sonabrief.com" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="grain-texture">
    <Navbar lang={lang} />
    <slot />
    <Footer currentLang={lang} />
  </body>
</html>
